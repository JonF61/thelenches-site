  <section id="harvington">
    <h2>Harvington Village Hall</h2>
    <div class="gallery gallery-one">
      <figure><img src="{{ '/images/photos/harvington-harvington-village-hall-and-yarn-tree.webp' | url }}" alt="Harvington Village Hall on Village Street, with a tree wrapped in colourful knitting in front" width="1400" height="994" loading="lazy"><figcaption class="small muted">Harvington Village Hall, Village Street</figcaption></figure>
