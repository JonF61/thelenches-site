---
permalink: /index.html
eleventyExcludeFromCollections: true
---
{#- Holding page until launch (Harvington stage 3, 16 Nov 2026; wording approved by Jon). Standalone, so none of the
    shared layout's Lenches wording shows. Replaced by the real Home page at the content stage. -#}
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site.name }} Village Website</title>
  <meta name="description" content="{{ site.description }}">
  {% if site.noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css?v={{ cssv }}">
  {%- if site.palette and site.palette.vars %}
  <style>:root{ {%- for k, v in site.palette.vars %}--{{ k }}:{{ v }};{% endfor -%} }</style>
  {%- endif %}
  <style>
    .holding{max-width:var(--maxw);margin:0 auto;padding:2.5rem 16px 3rem}
    .holding h1{font-size:clamp(2rem,5vw,2.8rem);margin:0 0 .3rem}
    .holding h1 span{color:var(--accent)}
    .holding p{font-size:1.1rem;max-width:56ch}
  </style>
</head>
<body>
  <main class="holding">
    <h1>{{ site.name }} <span>Village Website</span></h1>
    {% include "home-skyline.njk" %}
    <p>A new community website and weekly newsletter for {{ site.name }} is on its way.</p>
    <p>Got news or an event to share? Email <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
  </main>
</body>
</html>
