---
layout: base.njk
title: News & Events
description: What's on across the Lenches villages this week — events, news, notices and bin collection days.
---
<main class="container">
  <section>
    <div class="ne-top">
      <div class="ne-title">
        <h1>News &amp; Events</h1>
        <p class="lead">What's happening across the villages, gathered from the newsletter and other local sources.</p>
        <p><span class="datestamp">Page updated {{ updated | longDate }}</span></p>
      </div>
      <div class="bin-box" id="bin-box">
        <div>
          <strong>Bin collections</strong>
          <div class="small mut"><a href="https://www.wychavon.gov.uk/waste-and-recycling/bins-and-collections" target="_blank" rel="noopener">Check your bin day at Wychavon &rarr;</a></div>
        </div>
      </div>
    </div>
    <div class="notice">Got something to include? Email <a href="mailto:{{ site.email }}">{{ site.email }}</a> by the end of Wednesday.</div>
  </section>

  <section>
    <h2>Events</h2>
    {% for e in whatson.events | upcoming %}
    {% set d = e.date | dateParts %}
    <div class="event">
      <div class="date"><span class="dow">{{ d.dow }}</span><span class="day">{{ d.day }}</span><span class="mon">{{ d.mon }}</span></div>
      <div>
        <h3 class="mt0">{{ e.title }}</h3>
        <p class="mt0">{{ e.body }}{% if e.link %} <a href="{{ e.link.url }}" target="_blank" rel="noopener">{{ e.link.text }} &rarr;</a>{% endif %}</p>
      </div>
    </div>
    {% endfor %}
    {% if whatson.eventsFootnote %}<p class="small mut">{{ whatson.eventsFootnote }}</p>{% endif %}
  </section>

  <section id="signup">
    <h2>Get the newsletter</h2>
    <div class="signup">
      <p class="mt0">Sent every <strong>Thursday morning</strong>. To join, simply email <a href="mailto:{{ site.email }}?subject=Add%20me%20to%20the%20mailing%20list">{{ site.email }}</a> and ask to be added to the mailing list.</p>
      <p class="small muted">Haven't received one by the end of the week? Email us and we'll add you manually.</p>
    </div>
  </section>

  <section>
    <h2>News</h2>
    <div class="grid">
      {% for n in whatson.news %}
      <div class="card">
        <h3 class="mt0">{{ n.title }}</h3>
        <p>{{ n.body }}{% if n.link %} <a href="{{ n.link.url }}" target="_blank" rel="noopener">{{ n.link.text }} &rarr;</a>{% endif %}</p>
      </div>
      {% endfor %}
    </div>
  </section>

  <section>
    <h2>Notices</h2>
    <div class="grid">
      {% for n in whatson.notices %}
      <div class="card">
        <h3 class="mt0">{{ n.title }}</h3>
        <p class="mt0">{{ n.body }}{% if n.link %} <a href="{{ n.link.url }}" target="_blank" rel="noopener">{{ n.link.text }} &rarr;</a>{% endif %}</p>
      </div>
      {% endfor %}
    </div>
  </section>

  <section>
    <h2>Previous Newsletters</h2>
    <p class="mut">Every edition, newest first. Each one opens in your browser exactly as it appeared in the email.</p>
    <div class="card">
      <ul class="newsletter-archive mt0">
        {% for item in newsletters %}
        <li><a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </section>
</main>

<script>
(function () {
  var data = {{ bins | dump | safe }};
  var box = document.getElementById('bin-box');
  if (!box || !data || !data.collections) return;

  var colours = { black: '#2f2f2f', green: '#7ab648', brown: '#6b4a2c' };

  var now = new Date();
  var today = new Date(now); today.setHours(0, 0, 0, 0);

  function toDate(s) { var p = s.split('-'); return new Date(+p[0], p[1] - 1, +p[2]); }
  function expiry(s) { var d = toDate(s); d.setHours(10, 0, 0, 0); return d; }

  var next = null;
  for (var i = 0; i < data.collections.length; i++) {
    if (expiry(data.collections[i].date) > now) { next = data.collections[i]; break; }
  }
  if (!next) return;

  var d = toDate(next.date);
  var when = d.getTime() === today.getTime()
    ? 'Today'
    : d.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' });

  var label = next.bins.indexOf('black') > -1
    ? 'Black bin'
    : 'Green recycling bin' + (next.bins.indexOf('brown') > -1 ? ' &amp; brown garden bin' : '');

  var swatches = next.bins.map(function (b) {
    return '<div class="bin-swatch" style="background:' + (colours[b] || '#999') + ';"></div>';
  }).join('');

  box.innerHTML = swatches +
    '<div><strong>' + when + ' — ' + label + '</strong>' +
    '<div class="small mut">' + (next.note || 'Out by ' + data.putOutBy + '.') + '</div></div>';
})();
</script>
