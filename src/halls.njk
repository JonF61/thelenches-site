  <section id="rous-lench">
    <h2>Rous Lench Village Hall</h2>
    {#- Jon's photos from photos.json (Photos tab): 3113 whole hall, plus 3110 (moved from Groups, 13 Oct) -#}
    <div class="gallery">
      {%- for p in photos %}{% if p.slug == "rous-lench-img-3113" or p.slug == "rous-lench-img-3110" %}
