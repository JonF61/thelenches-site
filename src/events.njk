---
layout: base.njk
title: Events
description: What's on across the Lenches villages — upcoming events from the newsletter and local groups.
---
{#- Items come from src/items/ (hand-edited, via lib/whatson.js) and pipeline.json (written by scripts/publish). -#}
{#- A drawn tile (no image) floats right inside .item-body as a small thumbnail so the text wraps under it -#}
{#- "Lenches" badge marks items in the five Lenches (inLenches filter, lib/lenches.js); order stays by date -#}
{#- Image: the item's own, else a standing photo (Photos tab target event:<key>, eventImage filter), else a tile -#}
{#- Any image (own, organiser's or standing photo) shows beside the text on desktop, 360px wide and floated right so the text wraps
    down its left side (26 Oct: images below the text left a lot of white space); on phones it sits below the text, up to 420px wide.
    It opens full size when clicked (data-viewer); a credit shows under it -#}
<style>
  .item-card .item-body{display:flow-root}
  .item-body > .tile{float:right;margin:0 0 .4rem .9rem}
  .lenches-badge{display:inline-block;vertical-align:middle;margin-left:.35rem;padding:0 .45rem;border-radius:4px;background:#fbe6d6;color:#8a3e0c;font-size:.7rem;font-weight:600;line-height:1.6;white-space:nowrap}
  .ev-img{margin:0}
  .ev-img a{display:block}
  .ev-img img{display:block;width:100%;height:auto;border:1px solid #e6e1d6;border-radius:4px}
  .img-credit{margin:.3rem 0 0}
  .regulars{margin-top:1.6rem}
  .reg-list{list-style:none;margin:.4rem 0 0;padding:0;border:1px solid #e6e1d6;border-radius:6px;background:#fff}
  .reg-list li{display:grid;grid-template-columns:13.5rem 1fr;gap:.2rem 1rem;padding:.55rem .9rem;border-top:1px solid #efeae0}
  .reg-list li:first-child{border-top:0}
  .reg-when{white-space:nowrap}
  @media (max-width:559px){ .reg-list li{grid-template-columns:1fr} }
  @media (min-width:760px){
    .item-body > .ev-img{float:right;width:360px;margin:0 0 .5rem 1.2rem}
    .ev-img .img-credit{text-align:right}
  }
  @media (max-width:759px){
    .item-card .item-body:has(> .ev-img){display:flex;flex-direction:column}
    .item-body > .ev-img{order:9;max-width:420px;margin:.6rem 0 0}
  }
</style>
<main class="container">
  <div class="page-head">
    <h1>Events</h1>
    <p class="page-intro">What's on across the villages &middot; updated {{ updated | longDate }}{% if whatson.regulars | length %} &middot; <a href="#weekly-regulars">Weekly regulars &darr;</a>{% endif %}</p>
  </div>

  {% set groups = whatson.events | merge(pipeline.events) | upcoming | byMonth %}
  {% for g in groups %}
  <section class="month">
    <h2 class="list-label" id="{{ g.label | slugify }}">{{ g.label }}</h2>
    {% for e in g.items %}
    {% set d = e.date | dateParts %}
    {% set img = e | eventImage(photos) %}
    {#- id is linked from the home page's "more" links: keep the two in step. The heading's "-t" id gives Pagefind search results a link to each event. -#}
    <div class="item-card" id="{{ ('ev-' + e.date + '-' + e.title) | slugify }}">
      <div class="date" data-pagefind-ignore><span class="dow">{{ d.dow }}</span><span class="day">{{ d.day }}</span><span class="mon">{{ d.mon }}</span></div>
      <div class="item-body">
        {% if img %}<figure class="ev-img"><a href="{{ img.url | url }}" data-viewer aria-label="View full image"><img src="{{ img.url | url }}" alt="{{ img.alt | escape }}" loading="lazy"></a>{% if img.credit %}<figcaption data-pagefind-ignore class="img-credit small mut">{% if img.creditUrl %}<a href="{{ img.creditUrl | escape }}" target="_blank" rel="noopener">{{ img.credit | escape }}</a>{% else %}{{ img.credit | escape }}{% endif %}</figcaption>{% endif %}</figure>{% else %}{{ e | tileSvg | safe }}{% endif %}
        <h3 id="{{ ('ev-' + e.date + '-' + e.title) | slugify }}-t">{{ e.title | escape }}{% if e | inLenches %} <span class="lenches-badge" data-pagefind-ignore>Lenches</span>{% endif %}</h3>
        {% for p in e.body | paras %}<p>{{ p | escape }}{% if loop.last and e.link %} <a href="{{ e.link.url | escape }}" target="_blank" rel="noopener">{{ e.link.text | escape }} &rarr;</a>{% endif %}</p>{% endfor %}
      </div>
    </div>
    {% endfor %}
  </section>
  {% else %}
  <p class="muted">Nothing listed at the moment. Check back after Thursday's newsletter.</p>
  {% endfor %}
  {#- Weekly regulars (src/items/regulars.json, lib/whatson.js sorts them Monday first): one line each. -#}
  {% if whatson.regulars | length %}
  <section class="regulars" id="weekly-regulars">
    <h2>Weekly regulars</h2>
    <ul class="reg-list">
      {% for r in whatson.regulars %}
      <li><span class="reg-when"><b>{{ r.day }}</b>{% if r.time %} {{ r.time }}{% endif %}</span><span class="reg-what">{{ r.what }}{% if r.where %} &middot; {{ r.where }}{% endif %}{% if r.note %} <span class="mut">({{ r.note }})</span>{% endif %}{% if r.link %} &middot; <a href="{{ r.link.url | url if r.link.url.startsWith('/') else r.link.url }}">{{ r.link.text }}</a>{% endif %}</span></li>
      {% endfor %}
    </ul>
  </section>
  {% elif whatson.eventsFootnote %}<p class="small mut">{{ whatson.eventsFootnote }}</p>{% endif %}

  <div class="notice submit-note">Got an event to include? Email <a href="mailto:{{ site.email }}">{{ site.email }}</a> by 6pm on Wednesday. See our <a href="{{ '/contact/' | url }}#submit">submission guidelines</a>.</div>
</main>
