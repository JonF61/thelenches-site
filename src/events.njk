---
layout: base.njk
title: Events
description: What's on across the Lenches villages — upcoming events from the newsletter and local groups.
---
{#- Items come from src/items/ (hand-edited, via lib/whatson.js) and pipeline.json (written by scripts/publish). -#}
{#- Thumbnail/tile floats right inside .item-body so the text wraps under it on phones (no blank space) -#}
{#- "Lenches" badge marks items in the five Lenches (inLenches filter, lib/lenches.js); order stays by date -#}
{#- Image: the item's own, else a standing photo (Photos tab target event:<key>, eventImage filter), else a tile -#}
{#- The item's own image (usually a flyer) shows whole, below the text, max 420px wide (15 Oct); standing photos and tiles stay as thumbnails -#}
<style>
  .item-card .item-body{display:flow-root}
  .item-body > .thumb-link,.item-body > .tile{float:right;margin:0 0 .4rem .9rem}
  .lenches-badge{display:inline-block;vertical-align:middle;margin-left:.35rem;padding:0 .45rem;border-radius:4px;background:#fbe6d6;color:#8a3e0c;font-size:.7rem;font-weight:600;line-height:1.6;white-space:nowrap}
  .flyer-link{display:block;max-width:420px;margin:.6rem 0 0}
  .item-flyer{display:block;width:100%;height:auto;border:1px solid #e6e1d6;border-radius:4px}
  .img-credit{margin:.3rem 0 0}
</style>
<main class="container">
  <div class="page-head">
    <h1>Events</h1>
    <p class="page-intro">What's on across the villages &middot; updated {{ updated | longDate }}</p>
  </div>

  {% set groups = whatson.events | merge(pipeline.events) | upcoming | byMonth %}
  {% for g in groups %}
  <section class="month">
    <h2 class="list-label">{{ g.label }}</h2>
    {% for e in g.items %}
    {% set d = e.date | dateParts %}
    {% set img = e | eventImage(photos) %}
    {% set own = e.image and e.image.url %}
    {#- id is linked from the home page's "more" links: keep the two in step -#}
    <div class="item-card" id="{{ ('ev-' + e.date + '-' + e.title) | slugify }}">
      <div class="date"><span class="dow">{{ d.dow }}</span><span class="day">{{ d.day }}</span><span class="mon">{{ d.mon }}</span></div>
      <div class="item-body">
        {% if not own %}{% if img %}<a class="thumb-link" href="{{ img.url | url }}" data-viewer aria-label="View full image"><img class="item-thumb" src="{{ img.url | url }}" alt="{{ img.alt | escape }}" loading="lazy"></a>{% else %}{{ e | tileSvg | safe }}{% endif %}{% endif %}
        <h3>{{ e.title | escape }}{% if e | inLenches %} <span class="lenches-badge">Lenches</span>{% endif %}</h3>
        {% for p in e.body | paras %}<p>{{ p | escape }}{% if loop.last and e.link %} <a href="{{ e.link.url | escape }}" target="_blank" rel="noopener">{{ e.link.text | escape }} &rarr;</a>{% endif %}</p>{% endfor %}
        {% if own %}<a class="flyer-link" href="{{ e.image.url | url }}" data-viewer aria-label="View full image"><img class="item-flyer" src="{{ e.image.url | url }}" alt="{{ e.image.alt | escape }}" loading="lazy"></a>{% if e.image.credit %}<p class="img-credit small mut">{% if e.image.creditUrl %}<a href="{{ e.image.creditUrl | escape }}" target="_blank" rel="noopener">{{ e.image.credit | escape }}</a>{% else %}{{ e.image.credit | escape }}{% endif %}</p>{% endif %}{% endif %}
      </div>
    </div>
    {% endfor %}
  </section>
  {% else %}
  <p class="muted">Nothing listed at the moment. Check back after Thursday's newsletter.</p>
  {% endfor %}
  {% if whatson.eventsFootnote %}<p class="small mut">{{ whatson.eventsFootnote }}</p>{% endif %}

  <div class="notice submit-note">Got an event to include? Email <a href="mailto:{{ site.email }}">{{ site.email }}</a> by 6pm on Wednesday. See our <a href="{{ '/contact/' | url }}#submit">submission guidelines</a>.</div>
</main>
