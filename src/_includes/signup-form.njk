{#- Newsletter sign-up form: only on the sign-up page (newsletter.njk, /newsletter/); the
    home card, home intro and the band on other pages link there (27 Oct). Posts to the approvals
    Worker (POST /s, worker/src/signup.js), which checks Turnstile, saves a Sign-ups row and
    has signup.yml email a confirmation link (double opt-in). Turnstile loads only when
    someone clicks into the form; without JavaScript the Worker answers with a page
    offering the email address instead. Shown only when site.json has signupUrl and
    turnstileSiteKey (the callers fall back to "Email to join"). A failure that never reaches
    the Worker (robot check not loading or not answering, network error) is reported with a
    small POST carrying fail=1, a stage and a reason code; the Worker
    adds it to the Form failures tab (worker/src/formfail.js; 23 Nov; never the address). Since 27 Nov
    it also carries the address typed, if any, so Jon is alerted to review it (signup.js flagForReview). -#}
<form class="su-form" method="post" action="{{ site.signupUrl }}" data-sitekey="{{ site.turnstileSiteKey }}">
  <label class="sr-only" for="su-email">Your email address</label>
  <div class="su-row">
    <input id="su-email" name="email" type="email" maxlength="200" autocomplete="email" placeholder="your@email" required>
    <button type="submit" class="btn su-join">Join</button>
  </div>
  <div class="fb-hp" aria-hidden="true"><label for="su-website">Leave this empty</label><input id="su-website" name="website" type="text" tabindex="-1" autocomplete="off"></div>
  <input type="hidden" name="js" value="">
  <div class="su-ts"></div>
  <p class="su-status" role="status" aria-live="polite"></p>
</form>
{% include "turnstile-loader.njk" %}
<script>
(function () {
  var form = document.querySelector('.su-form');
  if (!form || !window.fetch || !window.FormData) return;
  var status = form.querySelector('.su-status'), box = form.querySelector('.su-ts'), button = form.querySelector('.su-join');
  var widget = null, token = '', waiting = [], widgetError = '', needsTick = false;
  function askTick() {
    say('Please tick the box above to confirm you\'re not a robot.');
    try { box.scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch (e) {}
  }
  function report(stage, reason) {
    try {
      var d = new FormData();
      d.set('fail', '1'); d.set('stage', stage); d.set('reason', String(reason || '').slice(0, 40));
      if (form.elements.email && form.elements.email.value) d.set('email', String(form.elements.email.value).slice(0, 200));
      if (navigator.sendBeacon) navigator.sendBeacon(form.action, d);
      else fetch(form.action, { method: 'POST', body: d, mode: 'no-cors', keepalive: true });
    } catch (e) {}
  }
  form.elements.js.value = '1';
  function say(text, bad) { status.textContent = text; status.className = 'su-status' + (bad ? ' bad' : text ? ' ok' : ''); }
  function got(t) { token = t || ''; var w = waiting; waiting = []; w.forEach(function (f) { f(token); }); }
  function render() {
    if (widget !== null || !window.turnstile) return;
    widget = window.turnstile.render(box, {
      sitekey: form.getAttribute('data-sitekey'), appearance: 'interaction-only', theme: 'light',
      callback: got, 'expired-callback': function () { token = ''; },
      // 27 Nov: the check wants a tick (the Facebook app's browser often does): say so and show it.
      'before-interactive-callback': function () { needsTick = true; if (button.disabled) askTick(); },
      'error-callback': function (code) { widgetError = 'widget-' + (code || 'error'); got(''); }
    });
  }
  // Turnstile loads only when someone starts using the form.
  form.addEventListener('focusin', function () {
    window.lenchesTurnstile(render, function () { report('page', 'script-load'); say('The robot check could not load. Please email {{ site.email }} and ask to be added.', true); });
  });
  function tokenSoon() {
    if (token) return Promise.resolve(token);
    if (needsTick) askTick();
    return new Promise(function (resolve) {
      waiting.push(resolve);
      // 27 Nov: a slow check gets a nudge after 3 seconds and up to a minute (was 15 seconds).
      setTimeout(function () { if (!token) { if (needsTick) askTick(); else say('Checking you\'re not a robot…'); } }, 3000);
      setTimeout(function () { resolve(token); }, 60000);
    });
  }
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (button.disabled) return;
    button.disabled = true;
    say('Sending…');
    window.lenchesTurnstile(render);
    tokenSoon().then(function (t) {
      if (!t) {
        report('page', widgetError || (window.turnstile ? 'no-token' : 'no-script'));
        throw new Error('We couldn\'t confirm you\'re not a robot. Please try again, or email {{ site.email }} and ask to be added.');
      }
      var data = new FormData(form);
      data.set('cf-turnstile-response', t);
      return fetch(form.action, { method: 'POST', body: data }).then(function (r) {
        return r.json().catch(function () { report('page', 'bad-reply-' + r.status); return { ok: false, message: 'Sorry, something went wrong. Please try again later.' }; });
      }, function (err) { report('page', 'network'); throw err; });
    }).then(function (res) {
      if (!res.ok) throw new Error(res.message || 'Sorry, something went wrong. Please try again later.');
      form.reset();
      say(res.message);
    }).catch(function (err) {
      say(err && err.message && !/fetch|network|load failed/i.test(err.message) ? err.message : 'Sorry, that couldn\'t be sent. Please check your connection and try again.', true);
    }).then(function () {
      button.disabled = false;
      token = '';
      if (widget !== null && window.turnstile) window.turnstile.reset(widget);
    });
  });
})();
</script>
