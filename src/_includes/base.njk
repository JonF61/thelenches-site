<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta name="google-site-verification" content="tZwnp0H9L9izwMlQb5imWeptFYtCY3UstxkKAWSvj38" />
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="icon" href="{{ '/images/favicon.svg' | url }}" type="image/svg+xml">
  {% if site.noindex or noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
  {% set pageTitle %}{% if page.url == "/" %}The Lenches — Village Website{% else %}{{ title }} — The Lenches{% endif %}{% endset %}
  {% set pageDesc = description or site.description %}
  {% set pageImage = ogImage or site.ogImage %}
  {% set pageImageAlt = ogImageAlt or site.ogImageAlt %}
  <title>{{ pageTitle }}</title>
  {% if pageDesc %}<meta name="description" content="{{ pageDesc }}">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="The Lenches Website">
  <meta property="og:locale" content="en_GB">
  <meta property="og:title" content="{{ pageTitle }}">
  {% if pageDesc %}<meta property="og:description" content="{{ pageDesc }}">{% endif %}
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% if pageImage %}<meta property="og:image" content="{{ pageImage }}">
  <meta property="og:image:alt" content="{{ pageImageAlt }}">{% endif %}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  {% if pageDesc %}<meta name="twitter:description" content="{{ pageDesc }}">{% endif %}
  {% if pageImage %}<meta name="twitter:image" content="{{ pageImage }}">
  <meta name="twitter:image:alt" content="{{ pageImageAlt }}">{% endif %}

  <link rel="stylesheet" href="{{ '/style.css' | url }}">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="container">
      <div class="brand-wrap">
        {#- On the home page the site name doubles as the page's H1. -#}
        {% if page.url == "/" %}<h1 class="brand-h1">{% endif %}<a class="brand" href="{{ '/' | url }}">The Lenches <span>Website</span></a>{% if page.url == "/" %}</h1>{% endif %}
        <p class="brand-villages">Church &middot; Rous &middot; Ab &middot; Atch &middot; Sheriffs</p>
      </div>
      <nav class="nav" aria-label="Main">
        {% for item in site.nav %}
        <a href="{{ item.url | url }}"{% if page.url == item.url %} class="active" aria-current="page"{% endif %}>{{ item.title }}</a>
        {% endfor %}
      </nav>
    </div>
  </header>

  <div id="main" tabindex="-1">
    {{ content | safe }}
    {#- Home page places its own sign-up box; every other page gets it at the bottom. -#}
    {% if page.url != "/" %}<div class="container signup-foot">{% include "signup.njk" %}</div>{% endif %}
  </div>

  <footer class="site-footer">
    <div class="container">
      <div>
        <strong>The Lenches Website</strong><br>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      </div>
      <div>
        {% for item in site.nav %}{% if not loop.first %} &middot; {% endif %}<a href="{{ item.url | url }}">{{ item.title }}</a>{% endfor %} &middot; <a href="{{ '/privacy/' | url }}">Privacy</a>
        {#- Team-only tools (Google sign-in required); hidden until site.json has teamUrl. -#}
        {% if site.teamUrl %} &middot; <a href="{{ site.teamUrl }}" rel="nofollow">Team</a>{% endif %}
      </div>
    </div>
    <div class="container">
      <p class="disclaimer">Site updated <time datetime="{{ updated }}">{{ updated | longDate }}</time>. Information on this website is provided by third parties and, while we try to keep it accurate and up to date, it may not always be. Spotted something wrong? Let us know.</p>
    </div>
  </footer>

  {#- In-page image viewer: any link with data-viewer opens its image here.
      Without JavaScript (or <dialog> support) the link simply opens the image. -#}
  <dialog class="img-viewer" id="img-viewer" aria-label="Image viewer">
    <button type="button" class="iv-close" aria-label="Close">&times;</button>
    <img alt="">
    <p class="iv-cap"></p>
  </dialog>
  <style>
  a[data-viewer]{cursor:zoom-in}
  .img-viewer{border:0;padding:0;margin:0;background:transparent;width:100vw;height:100vh;height:100dvh;max-width:100vw;max-height:100vh;max-height:100dvh}
  .img-viewer[open]{display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:zoom-out}
  .img-viewer::backdrop{background:rgba(0,0,0,.85)}
  .img-viewer img{max-width:92vw;max-height:80vh;max-height:80dvh;object-fit:contain;border-radius:6px;background:#fff;cursor:default}
  .iv-cap{color:#fff;margin:.6rem 1rem 0;font-size:.95rem;text-align:center;max-width:92vw}
  .iv-cap:empty{display:none}
  .iv-close{position:absolute;top:12px;right:12px;width:44px;height:44px;border-radius:50%;border:0;background:rgba(255,255,255,.2);color:#fff;font-size:28px;line-height:1;cursor:pointer}
  .iv-close:focus-visible{outline:2px solid #fff;outline-offset:2px}
  html.iv-open{overflow:hidden}
  </style>
  <script>
  (function () {
    var d = document.getElementById('img-viewer');
    if (!d || typeof d.showModal !== 'function') return;
    var img = d.querySelector('img'), cap = d.querySelector('.iv-cap'), from = null;
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[data-viewer]');
      if (!a || e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      var t = a.querySelector('img');
      var text = (t && t.alt) || a.getAttribute('data-caption') || '';
      img.src = a.href;
      img.alt = text;
      cap.textContent = text;
      from = a;
      d.showModal();
      document.documentElement.classList.add('iv-open');
    });
    d.addEventListener('click', function (e) { if (e.target !== img) d.close(); });
    d.addEventListener('close', function () {
      document.documentElement.classList.remove('iv-open');
      img.removeAttribute('src');
      if (from) from.focus();
    });
  })();
  </script>

</body>
</html>
