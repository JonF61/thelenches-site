<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta name="google-site-verification" content="tZwnp0H9L9izwMlQb5imWeptFYtCY3UstxkKAWSvj38" />
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="icon" href="{{ '/images/favicon.svg' | url }}" type="image/svg+xml">
  {% if site.noindex or noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
  {#- seoTitle (front matter) = the search/tab title only; the page heading and menu keep title. -#}
  {% set pageTitle %}{% if seoTitle %}{{ seoTitle }}{% elif page.url == "/" %}The Lenches — Village Website{% else %}{{ title }} — The Lenches{% endif %}{% endset %}
  {% set pageDesc = description or site.description %}
  {% set pageImage = ogImage or site.ogImage %}
  {% set pageImageAlt = ogImageAlt or site.ogImageAlt %}
  <title>{{ pageTitle | safe }}</title>
  {% if pageDesc %}<meta name="description" content="{{ pageDesc }}">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="The Lenches Website">
  <meta property="og:locale" content="en_GB">
  <meta property="og:title" content="{{ pageTitle | safe }}">
  {% if pageDesc %}<meta property="og:description" content="{{ pageDesc }}">{% endif %}
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% if pageImage %}<meta property="og:image" content="{{ pageImage }}">
  <meta property="og:image:alt" content="{{ pageImageAlt }}">{% endif %}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle | safe }}">
  {% if pageDesc %}<meta name="twitter:description" content="{{ pageDesc }}">{% endif %}
  {% if pageImage %}<meta name="twitter:image" content="{{ pageImage }}">
  <meta name="twitter:image:alt" content="{{ pageImageAlt }}">{% endif %}

  {#- pageTitle is escaped once inside its set block, so | safe stops "&" showing as "&amp;amp;". -#}
  {% if page.url == "/" %}<script type="application/ld+json">{{ site | siteLd | safe }}</script>{% endif %}
  <link rel="stylesheet" href="{{ '/style.css' | url }}?v={{ cssv }}">
  {#- Set before first paint so the phone menu starts closed without a jump; without JavaScript the menu is always shown. -#}
  <script>document.documentElement.classList.add('js')</script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="container">
      <div class="brand-wrap">
        {#- On the home page the site name doubles as the page's H1. -#}
        {% if page.url == "/" %}<h1 class="brand-h1">{% endif %}<a class="brand" href="{{ '/' | url }}">The Lenches <span>Website</span></a>{% if page.url == "/" %}</h1>{% endif %}
        <p class="brand-villages">Church &middot; Rous &middot; Ab &middot; Atch &middot; Sheriffs</p>
      </div>
      <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
      <nav class="nav" id="site-nav" aria-label="Main">
        {#- A nav item is active on its own URL, or on any page whose first path segment is in its match list (site.json). -#}
        {% set navSeg = (page.url or '').split('/')[1] %}
        {% for item in site.nav %}
        {% set isHere = page.url == item.url %}
        {% set inSection = item.match and item.match.includes(navSeg) %}
        <a href="{{ item.url | url }}"{% if isHere %} class="active" aria-current="page"{% elif inSection %} class="active"{% endif %}>{{ item.title }}</a>
        {% endfor %}
      </nav>
    </div>
  </header>

  <div id="main" tabindex="-1">
    {#- Pagefind (build.yml, after Eleventy) indexes only this wrapper, so menus, footer and forms stay out
        of search results; a page with "search: false" in its front matter is left out altogether. -#}
    {#- data-src: the page's own template, for the team's Edit page tool (only text written there can be edited). -#}
    <div{% if search !== false %} data-pagefind-body{% endif %} data-src="{{ page.inputPath }}">{{ content | safe }}</div>
    {#- Home page places its own sign-up card (near the top) and feedback form (below the
        map); every other page gets both at the bottom, the form above the sign-up band
        (which links to /newsletter/, so that page has the feedback form only). -#}
    {% if page.url != "/" %}<div class="container signup-foot">{% include "feedback.njk" %}{% if page.url != "/newsletter/" %}{% include "signup.njk" %}{% endif %}</div>{% endif %}
  </div>

  <footer class="site-footer">
    <div class="container">
      <div>
        <strong>The Lenches Website</strong><br>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      </div>
      {#- Every page, grouped as on the Home page (site.json footer). -#}
      <nav class="footer-nav" aria-label="All pages">
        {% for group in site.footer %}
        <div class="footer-col">
          <h2 class="footer-head">{{ group.title }}</h2>
          <ul>
            {% for item in group.links %}<li><a href="{{ item.url | url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a></li>{% endfor %}
            {#- Team-only tools (Google sign-in required); hidden until site.json has teamUrl. -#}
            {% if loop.last and site.teamUrl %}<li><a href="{{ site.teamUrl }}" rel="nofollow">Team</a></li><li><a href="{{ site.teamUrl }}/page?p={{ page.url | urlencode }}" rel="nofollow">Edit page</a></li>{% endif %}
          </ul>
        </div>
        {% endfor %}
      </nav>
    </div>
    <div class="container">
      <p class="disclaimer">Site updated <time datetime="{{ updated }}">{{ updated | longDate }}</time>. Information on this website is provided by third parties and, while we try to keep it accurate and up to date, it may not always be. Spotted something wrong? Let us know.</p>
    </div>
  </footer>

  {#- In-page image viewer: any link with data-viewer opens its image here.
      Without JavaScript (or <dialog> support) the link simply opens the image. -#}
  <dialog class="img-viewer" id="img-viewer" aria-label="Image viewer">
    <button type="button" class="iv-close" aria-label="Close">&times;</button>
    <img alt="">
    <p class="iv-cap"></p>
  </dialog>
  <style>
  a[data-viewer]{cursor:zoom-in}
  .img-viewer{border:0;padding:0;margin:0;background:transparent;width:100vw;height:100vh;height:100dvh;max-width:100vw;max-height:100vh;max-height:100dvh}
  .img-viewer[open]{display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:zoom-out}
  .img-viewer::backdrop{background:rgba(0,0,0,.85)}
  .img-viewer img{max-width:92vw;max-height:80vh;max-height:80dvh;object-fit:contain;border-radius:6px;background:#fff;cursor:default}
  .iv-cap{color:#fff;margin:.6rem 1rem 0;font-size:.95rem;text-align:center;max-width:92vw}
  .iv-cap:empty{display:none}
  .iv-close{position:absolute;top:12px;right:12px;width:44px;height:44px;border-radius:50%;border:0;background:rgba(255,255,255,.2);color:#fff;font-size:28px;line-height:1;cursor:pointer}
  .iv-close:focus-visible{outline:2px solid #fff;outline-offset:2px}
  html.iv-open{overflow:hidden}
  </style>
  <script>
  (function () {
    var b = document.querySelector('.nav-toggle'), n = document.getElementById('site-nav');
    if (!b || !n) return;
    function set(open) { b.setAttribute('aria-expanded', open ? 'true' : 'false'); n.classList.toggle('open', open); }
    b.addEventListener('click', function () { set(b.getAttribute('aria-expanded') !== 'true'); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && n.classList.contains('open')) { set(false); b.focus(); }
    });
  })();
  (function () {
    // Sticky header: slim it once scrolled (on at 80px, off under 20px so it doesn't flicker), and keep --hdr at its height for anchor links.
    var h = document.querySelector('.site-header'), r = document.documentElement;
    if (!h) return;
    function size() { r.style.setProperty('--hdr', (h.offsetHeight + 8) + 'px'); }
    function onScroll() {
      var y = window.scrollY, s = h.classList.contains('scrolled');
      if (!s && y > 80) { h.classList.add('scrolled'); size(); } else if (s && y < 20) { h.classList.remove('scrolled'); size(); }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', size);
    size(); onScroll();
  })();
  (function () {
    var d = document.getElementById('img-viewer');
    if (!d || typeof d.showModal !== 'function') return;
    var img = d.querySelector('img'), cap = d.querySelector('.iv-cap'), from = null;
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[data-viewer]');
      if (!a || e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      var t = a.querySelector('img');
      var text = (t && t.alt) || a.getAttribute('data-caption') || '';
      img.src = a.href;
      img.alt = text;
      cap.textContent = text;
      from = a;
      d.showModal();
      document.documentElement.classList.add('iv-open');
    });
    d.addEventListener('click', function (e) { if (e.target !== img) d.close(); });
    d.addEventListener('close', function () {
      document.documentElement.classList.remove('iv-open');
      img.removeAttribute('src');
      if (from) from.focus();
    });
  })();
  </script>

  {%- if site.cfAnalyticsToken %}
  {#- Cloudflare Web Analytics: counts visits, no cookies (privacy page section 11). -#}
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cfAnalyticsToken }}"}'></script>
  {%- endif %}
</body>
</html>
