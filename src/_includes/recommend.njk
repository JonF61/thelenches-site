{#- Recommend buttons on Local trades (trades.njk) and Where to eat (eat.njk). Each card has a
    hidden button (data-kind, data-entry = the entry's fixed id); this script shows them and,
    on a click, moves the one form below into that card. It posts to the approvals Worker
    (POST /r, worker/src/recommend.js), which checks Turnstile, saves a Recommendations row
    and has recommend.yml email a confirm link; nothing counts until that is pressed. Counts
    come from src/_data/recommends.json. Shown only when site.json has recommendUrl and
    turnstileSiteKey; without JavaScript the buttons stay hidden. -#}
{% if site.recommendUrl and site.turnstileSiteKey %}
<form class="rec-form" method="post" action="{{ site.recommendUrl }}" data-sitekey="{{ site.turnstileSiteKey }}" hidden>
  <label class="sr-only" for="rec-email">Your email address</label>
  <div class="rec-row">
    <input id="rec-email" name="email" type="email" maxlength="200" autocomplete="email" placeholder="Your email" required>
    <button type="submit" class="btn rec-send">Send</button>
  </div>
  <p class="rec-help small">We&rsquo;ll email you a link to confirm. Your address is never shown or shared.</p>
  <input type="hidden" name="kind" value="">
  <input type="hidden" name="entry" value="">
  <div class="fb-hp" aria-hidden="true"><label for="rec-website">Leave this empty</label><input id="rec-website" name="website" type="text" tabindex="-1" autocomplete="off"></div>
  <input type="hidden" name="js" value="">
  <div class="rec-ts"></div>
  <p class="rec-status small" role="status" aria-live="polite"></p>
</form>
{% include "turnstile-loader.njk" %}
<script>
(function () {
  var form = document.querySelector('.rec-form');
  if (!form || !window.fetch || !window.FormData) return;
  var status = form.querySelector('.rec-status'), box = form.querySelector('.rec-ts'), button = form.querySelector('.rec-send');
  var widget = null, token = '', waiting = [], current = null;
  form.elements.js.value = '1';
  function say(text, bad) { status.textContent = text; status.className = 'rec-status small' + (bad ? ' bad' : text ? ' ok' : ''); }
  function got(t) { token = t || ''; var w = waiting; waiting = []; w.forEach(function (f) { f(token); }); }
  function render() {
    if (widget !== null || !window.turnstile) return;
    widget = window.turnstile.render(box, {
      sitekey: form.getAttribute('data-sitekey'), appearance: 'interaction-only', theme: 'light',
      callback: got, 'expired-callback': function () { token = ''; },
      'error-callback': function () { got(''); }
    });
  }
  Array.prototype.forEach.call(document.querySelectorAll('.rec-btn'), function (b) {
    b.hidden = false;
    b.addEventListener('click', function () {
      if (current === b && !form.hidden) { form.hidden = true; b.setAttribute('aria-expanded', 'false'); return; }
      if (current) current.setAttribute('aria-expanded', 'false');
      current = b;
      b.setAttribute('aria-expanded', 'true');
      form.elements.kind.value = b.getAttribute('data-kind');
      form.elements.entry.value = b.getAttribute('data-entry');
      b.parentNode.insertBefore(form, b.nextSibling);
      form.hidden = false;
      say('');
      form.elements.email.focus();
    });
  });
  form.addEventListener('focusin', function () {
    window.lenchesTurnstile(render, function () { say('The robot check could not load. Please try again later.', true); });
  });
  function tokenSoon() {
    if (token) return Promise.resolve(token);
    return new Promise(function (resolve) {
      waiting.push(resolve);
      setTimeout(function () { resolve(token); }, 15000);
    });
  }
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (button.disabled) return;
    button.disabled = true;
    say('Sending…');
    window.lenchesTurnstile(render);
    tokenSoon().then(function (t) {
      if (!t) throw new Error('We couldn\'t confirm you\'re not a robot. Please try again in a moment.');
      var data = new FormData(form);
      data.set('cf-turnstile-response', t);
      return fetch(form.action, { method: 'POST', body: data }).then(function (r) {
        return r.json().catch(function () { return { ok: false, message: 'Sorry, something went wrong. Please try again later.' }; });
      });
    }).then(function (res) {
      if (!res.ok) throw new Error(res.message || 'Sorry, something went wrong. Please try again later.');
      form.elements.email.value = '';
      say(res.message);
    }).catch(function (err) {
      say(err && err.message && !/fetch|network/i.test(err.message) ? err.message : 'Sorry, that couldn\'t be sent. Please check your connection and try again.', true);
    }).then(function () {
      button.disabled = false;
      token = '';
      if (widget !== null && window.turnstile) window.turnstile.reset(widget);
    });
  });
})();
</script>
{% endif %}
