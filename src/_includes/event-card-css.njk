{#- Event card styles: the Events page and each event's own page (SEO step 1, 26 Nov 2026). -#}
<style>
  .item-card .item-body{display:flow-root}
  .item-body > .tile{float:right;margin:0 0 .4rem .9rem}
  .lenches-badge{display:inline-block;vertical-align:middle;margin-left:.35rem;padding:0 .45rem;border-radius:4px;background:#fbe6d6;color:#8a3e0c;font-size:.7rem;font-weight:600;line-height:1.6;white-space:nowrap}
  .ev-img{margin:0}
  .ev-img a{display:block}
  .ev-img img{display:block;width:auto;max-width:100%;height:auto;max-height:200px;border:1px solid #e6e1d6;border-radius:4px}
  .img-credit{margin:.3rem 0 0}
  .cal-add{margin:.5rem 0 0;font-size:.9rem}
  .cal-add{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem}
  .cal-sep{color:var(--muted,#777)}
  .ev-title{color:inherit;text-decoration:none}
  .ev-title:hover,.ev-title:focus{text-decoration:underline}
  @media (min-width:760px){
    .item-body > .ev-img{float:right;width:auto;max-width:360px;margin:0 0 .5rem 1.2rem}
    .ev-img img{max-height:240px}
    .ev-img .img-credit{text-align:right}
  }
  @media (max-width:759px){
    .item-card .item-body:has(> .ev-img){display:flex;flex-direction:column}
    .item-body > .ev-img{order:9;max-width:420px;margin:.6rem 0 0;align-self:flex-start}
  }
</style>
