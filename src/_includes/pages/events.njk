{#- Shared events page (Harvington stage 6b, 16 Nov 2026): each site's sites/<site>/ page sets its own wording, then includes this. -#}
{%- include "event-card-css.njk" %}
<main class="container">
  <div class="page-head">
    <h1>Events</h1>
    <p class="page-intro">{{ pageIntro | safe }}</p>
  </div>
  {%- if weekendButton %}
  {#- This weekend page (SEO step 4, 26 Nov 2026): a site with sites/<site>/this-weekend.njk sets weekendButton. -#}
  <p class="wk-link"><a class="btn btn-outline" href="{{ '/events/this-weekend/' | url }}">This weekend &rarr;</a></p>
  {%- endif %}

  {% set upcomingEvents = whatson.events | merge(pipeline.events) | upcoming %}
  {#- Google event listings (lib/schema.js). -#}
  <script type="application/ld+json">{{ upcomingEvents | eventsLd(photos, site) | safe }}</script>
  {% set groups = upcomingEvents | byMonth %}
  {% for g in groups %}
  <section class="month">
    <h2 class="list-label" id="{{ g.label | slugify }}">{{ g.label }}</h2>
    {% for e in g.items %}
    {% include "event-card.njk" %}
    {% endfor %}
  </section>
  {% else %}
  <p class="muted">{{ emptyNote | safe }}</p>
  {% endfor %}
  {#- Regular activities left this page 30 Oct (Jon): they are on /regulars/ and in the newsletter. -#}

  <div class="notice submit-note">{{ submitNote | safe }}</div>
</main>
