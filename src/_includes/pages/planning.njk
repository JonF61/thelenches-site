{#- Shared Planning page (25 Nov 2026, Jon): Wychavon's weekly planning lists for the site's parishes
    (site.json planningParishes), last 8 weeks, from _data/planning.json (written by scripts/planning).
    Each site's living-here/planning.njk sets its wording (pageIntro), then includes this.
    Laid out like the Events page (Jon, 25 Nov: no wall of text): a heading per week, then one
    item-card per entry with the date box (date valid, decided or appeal started) and a label for
    its kind. Reference, location, proposal, type, date, decision and link only; tree works left out. -#}
{%- set months = ["January","February","March","April","May","June","July","August","September","October","November","December"] -%}
{%- macro weekHead(w) -%}{{ w.from.slice(8,10) | int }}{% if w.from.slice(5,7) != w.to.slice(5,7) %} {{ months[(w.from.slice(5,7) | int) - 1] }}{% endif %} to {{ w.to.slice(8,10) | int }} {{ months[(w.to.slice(5,7) | int) - 1] }} {{ w.to.slice(0,4) }}{%- endmacro -%}
{%- set parts = [["applications", "New application", "Valid", "new applications"], ["decisions", "Decision", "Decided", "decisions"], ["appeals", "Appeal", "Appeal started", "appeals"]] -%}
<style>
.pl-label{display:inline-block;margin:0 0 .3rem;padding:0 .45rem;border-radius:4px;background:var(--green-light,#EFE7D3);color:var(--green-dark,#2E3D26);font-size:.75rem;font-weight:700;line-height:1.7;letter-spacing:.02em}
.pl-label.pl-decision{background:#fdf0dc;color:#7a4a06}
.pl-label.pl-appeal{background:#fbe6d6;color:#8a3e0c}
.pl-meta{margin:.35rem 0 0;font-size:.9rem;color:var(--muted,#666)}
.pl-none{margin:.2rem 0 1rem;color:var(--muted,#666);font-size:.95rem}
.pl-week .item-card h3{font-size:1.02rem}
.pl-homes{border-left:5px solid #b5471b}
.pl-badge-homes{display:inline-block;margin:0 0 .3rem .3rem;padding:0 .45rem;border-radius:4px;background:#b5471b;color:#fff;font-size:.75rem;font-weight:700;line-height:1.7}
.pl-status{margin:.35rem 0 0;font-size:.9rem}
.pl-status strong{color:var(--green-dark,#2E3D26)}
.pl-divider{border:0;border-top:3px solid var(--green-dark,#2E3D26);margin:2.2rem 0 1.2rem}
.pl-awaiting-head{font-size:1.45rem;margin:0 0 .3rem;color:var(--green-dark,#2E3D26)}
.pl-recent-head{font-size:1.1rem;margin:1.6rem 0 .5rem;color:var(--green-dark,#2E3D26)}
.pl-decided{opacity:.92}
.pl-key{display:flex;flex-wrap:wrap;gap:.5rem;margin:.4rem 0 1rem}
.pl-key span{background:#fff;border:1px solid #e6e1d6;border-radius:8px;padding:.35rem .7rem;font-size:.92rem}
</style>
<main class="container">
  <div class="page-head">
    <h1>{{ heading or "Planning applications" }}</h1>
    <p class="page-intro">{{ pageIntro | safe }}</p>
    <p class="muted">Updated each week from Wychavon's lists. <a href="{{ council.planning.commentUrl }}" target="_blank" rel="noopener">Search all applications on Wychavon's site</a> &middot; <a href="/living-here/council/#planning">Parish councils and how to comment</a></p>
  </div>
  {%- set weeks = planning.weeks if planning and planning.weeks else [] %}
  {%- for w in weeks %}
  <section class="month pl-week">
    <h2 class="list-label" id="week-{{ w.from }}">{{ weekHead(w) }}</h2>
    {%- set empty = [] %}{% set notYet = [] %}
    {%- for p in parts %}
    {%- set list = w[p[0]] or [] %}
    {%- if not list.length %}{% if w.lists and w.lists[p[0]] %}{% set empty = (empty.push(p[3]), empty) %}{% else %}{% set notYet = (notYet.push(p[3]), notYet) %}{% endif %}{% endif %}
    {%- for e in list %}
    {%- set d = e.date | dateParts if e.date else null %}
    <div class="item-card{% if e | planningHomes %} pl-homes{% endif %}" id="pl-{{ e.ref | slugify }}">
      {%- if d %}<div class="date" data-pagefind-ignore><span class="dow">{{ d.dow }}</span><span class="day">{{ d.day }}</span><span class="mon">{{ d.mon }}</span></div>{% endif %}
      <div class="item-body">
        <span class="pl-label pl-{{ p[1] | lower | replace(' ', '-') }}" data-pagefind-ignore>{{ p[1] }}{% if e.decision %}: {{ e.decision }}{% endif %}</span>{% set hl = e | planningHomes %}{% if hl %}<span class="pl-badge-homes" data-pagefind-ignore>{{ hl }}</span>{% endif %}
        <h3 id="pl-{{ e.ref | slugify }}-t">{{ e.location }}</h3>
        <p>{{ e.proposal }}{% if not e.proposal.endsWith('.') %}.{% endif %}</p>
        <p class="pl-meta">{% if e.type %}{{ e.type }} &middot; {% endif %}<a href="{{ e.link }}" target="_blank" rel="noopener">{{ e.ref }} on Wychavon's site &rarr;</a> &middot; <a href="{{ e.location | planningMap }}" target="_blank" rel="noopener">Map &rarr;</a></p>
      </div>
    </div>
    {%- endfor %}
    {%- endfor %}
    {%- if empty.length %}<p class="pl-none">No {% if empty.length > 2 %}{{ empty.slice(0, -1) | join(", ") }} or {{ empty | last }}{% else %}{{ empty | join(" or ") }}{% endif %} this week.</p>{% endif %}
    {%- if notYet.length %}<p class="pl-none">{{ notYet | join(" and ") | capitalize }}: not yet published by Wychavon.</p>{% endif %}
  </section>
  {%- else %}
  <p class="muted">No weekly lists yet: check back after the next one.</p>
  {%- endfor %}
  {%- set open = planning.open if planning and planning.open else [] %}
  {%- set k = open | planningCounts %}
  {%- set shown = [] %}{% for w in weeks %}{% for e in w.applications or [] %}{% set shown = (shown.push(e.ref), shown) %}{% endfor %}{% endfor %}
  {%- set older = [] %}{% set recent = [] %}{% for e in open %}{% if e.decisionDate %}{% set recent = (recent.push(e), recent) %}{% elif e.ref not in shown %}{% set older = (older.push(e), older) %}{% endif %}{% endfor %}
  {%- if open.length %}
  <hr class="pl-divider">
  <section class="month pl-week" id="awaiting">
    <h2 class="pl-awaiting-head" id="awaiting-a-decision">Still awaiting a decision</h2>
    <p class="pl-none">Older applications Wychavon hasn't decided yet. Ones from the weeks above aren't repeated here.</p>
    <div class="pl-key" data-pagefind-ignore>
      <span><b>{{ k.total }}</b> application{{ "" if k.total == 1 else "s" }} awaiting a decision in all</span>
      {%- if k.withHomes %}<span><b>{{ k.withHomes }}</b> include{{ "s" if k.withHomes == 1 else "" }} new homes ({{ k.homes }} home{{ "" if k.homes == 1 else "s" }} at most)</span>{% endif %}
      {%- if k.comments %}<span><b>{{ k.comments }}</b> open for comments</span>{% endif %}
    </div>
    {%- for e in older %}
    {%- set d = e.valid | dateParts if e.valid else null %}
    <div class="item-card{% if e.homes %} pl-homes{% endif %}" id="open-{{ e.ref | slugify }}">
      {%- if d %}<div class="date" data-pagefind-ignore><span class="dow">{{ d.dow }}</span><span class="day">{{ d.day }}</span><span class="mon">{{ d.mon }}</span></div>{% endif %}
      <div class="item-body">
        {% if e.type %}<span class="pl-label" data-pagefind-ignore>{{ e.type }}</span>{% endif %}{% if e.homesLabel %}<span class="pl-badge-homes" data-pagefind-ignore>{{ e.homesLabel }}</span>{% endif %}
        <h3 id="open-{{ e.ref | slugify }}-t">{{ e.location }}</h3>
        <p>{{ e.proposal }}{% if not e.proposal.endsWith('.') %}.{% endif %}</p>
        <p class="pl-status">{% for x in e | planningStatus %}{% if not loop.first %} &middot; {% endif %}{% if x.strong %}<strong>{{ x.text }}</strong>{% else %}{{ x.text }}{% endif %}{% endfor %}</p>
        <p class="pl-meta"><a href="{{ e.link }}" target="_blank" rel="noopener">{{ e.ref }} on Wychavon's site &rarr;</a> &middot; <a href="{{ e.location | planningMap }}" target="_blank" rel="noopener">Map &rarr;</a></p>
      </div>
    </div>
    {%- endfor %}
    {%- if not older.length %}<p class="pl-none">None: every undecided application is in the weeks above.</p>{% endif %}
    <p class="pl-none">New homes first, then newest first.</p>
    {%- if recent.length %}
    <h3 class="pl-recent-head" id="recently-decided">Recently decided</h3>
    {%- for e in recent | sort(true, false, "decisionDate") %}
    {%- set d = e.decisionDate | dateParts %}
    <div class="item-card pl-decided{% if e.homes %} pl-homes{% endif %}" id="open-{{ e.ref | slugify }}">
      <div class="date" data-pagefind-ignore><span class="dow">{{ d.dow }}</span><span class="day">{{ d.day }}</span><span class="mon">{{ d.mon }}</span></div>
      <div class="item-body">
        <span class="pl-label pl-decision" data-pagefind-ignore>Decided: {{ e.decision }}</span>{% if e.homesLabel %}<span class="pl-badge-homes" data-pagefind-ignore>{{ e.homesLabel }}</span>{% endif %}
        <h3 id="open-{{ e.ref | slugify }}-t">{{ e.location }}</h3>
        <p>{{ e.proposal }}{% if not e.proposal.endsWith('.') %}.{% endif %}</p>
        <p class="pl-meta">{% if e.type %}{{ e.type }} &middot; {% endif %}<a href="{{ e.link }}" target="_blank" rel="noopener">{{ e.ref }} on Wychavon's site &rarr;</a> &middot; <a href="{{ e.location | planningMap }}" target="_blank" rel="noopener">Map &rarr;</a></p>
      </div>
    </div>
    {%- endfor %}
    <p class="pl-none">Decided applications stay here for 4 weeks after the decision.</p>
    {%- endif %}
  </section>
  {%- endif %}
  <p class="muted">From Wychavon District Council's weekly planning lists. Plans, documents and comments are on Wychavon's planning site: follow an application's reference.</p>
</main>
