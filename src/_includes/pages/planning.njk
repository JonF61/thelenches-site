{#- Shared Planning page (25 Nov 2026, Jon): Wychavon's weekly planning lists for the site's parishes
    (site.json planningParishes), last 8 weeks, from _data/planning.json (written by scripts/planning).
    Each site's living-here/planning.njk sets its wording (pageIntro), then includes this.
    Laid out like the Events page (Jon, 25 Nov: no wall of text): a heading per week, then one
    item-card per entry with the date box (date valid, decided or appeal started) and a label for
    its kind. Reference, location, proposal, type, date, decision and link only; tree works left out. -#}
{%- set months = ["January","February","March","April","May","June","July","August","September","October","November","December"] -%}
{%- macro weekHead(w) -%}{{ w.from.slice(8,10) | int }}{% if w.from.slice(5,7) != w.to.slice(5,7) %} {{ months[(w.from.slice(5,7) | int) - 1] }}{% endif %} to {{ w.to.slice(8,10) | int }} {{ months[(w.to.slice(5,7) | int) - 1] }} {{ w.to.slice(0,4) }}{%- endmacro -%}
{%- set parts = [["applications", "New application", "Valid", "new applications"], ["decisions", "Decision", "Decided", "decisions"], ["appeals", "Appeal", "Appeal started", "appeals"]] -%}
<style>
.pl-label{display:inline-block;margin:0 0 .3rem;padding:0 .45rem;border-radius:4px;background:var(--green-light,#EFE7D3);color:var(--green-dark,#2E3D26);font-size:.75rem;font-weight:700;line-height:1.7;letter-spacing:.02em}
.pl-label.pl-decision{background:#fdf0dc;color:#7a4a06}
.pl-label.pl-appeal{background:#fbe6d6;color:#8a3e0c}
.pl-meta{margin:.35rem 0 0;font-size:.9rem;color:var(--muted,#666)}
.pl-none{margin:.2rem 0 1rem;color:var(--muted,#666);font-size:.95rem}
.pl-week .item-card h3{font-size:1.02rem}
.pl-homes{border-left:5px solid #b5471b}
.pl-badge-homes{display:inline-block;margin:0 0 .3rem .3rem;padding:0 .45rem;border-radius:4px;background:#b5471b;color:#fff;font-size:.75rem;font-weight:700;line-height:1.7}
.pl-status{margin:.35rem 0 0;font-size:.9rem}
.pl-status strong{color:var(--green-dark,#2E3D26)}
.pl-divider{border:0;border-top:3px solid var(--green-dark,#2E3D26);margin:2.2rem 0 1.2rem}
.pl-awaiting-head{font-size:1.45rem;margin:0 0 .3rem;color:var(--green-dark,#2E3D26)}
.pl-recent-head{font-size:1.1rem;margin:1.6rem 0 .5rem;color:var(--green-dark,#2E3D26)}
.pl-decided{opacity:.92}
.pl-key{display:flex;flex-wrap:wrap;gap:.5rem;margin:.4rem 0 1rem}
.pl-closing{background:#fff8ea;border:1px solid #ecd9a8;border-left:5px solid #c58a12;border-radius:10px;padding:.9rem 1.1rem .6rem;margin:0 0 1.6rem}
.pl-closing h2{font-size:1.2rem;margin:0 0 .2rem;color:var(--green-dark,#2E3D26)}
.pl-closing .pl-sub{margin:0 0 .7rem;font-size:.92rem;color:var(--muted,#666)}
.pl-closing ul{list-style:none;margin:0;padding:0}
.pl-closing li{padding:.55rem 0;border-top:1px solid #f0e4c4}
.pl-closing li:first-child{border-top:0}
.pl-when{display:inline-block;margin:0 .35rem .2rem 0;padding:0 .45rem;border-radius:4px;background:#c58a12;color:#fff;font-size:.78rem;font-weight:700;line-height:1.7}
.pl-closing .pl-where{font-weight:700}
.pl-closing .pl-what{display:block;font-size:.95rem;margin:.1rem 0}
.pl-closing .pl-meta{margin:.1rem 0 0}
.pl-committee{background:#eef4fa;border:1px solid #c9dcec;border-left:5px solid #4d7ea8;border-radius:10px;padding:.9rem 1.1rem .6rem;margin:0 0 1.6rem}
.pl-committee h2{font-size:1.2rem;margin:0 0 .2rem;color:var(--green-dark,#2E3D26)}
.pl-committee .pl-sub{margin:0 0 .7rem;font-size:.92rem;color:var(--muted,#666)}
.pl-committee ul{list-style:none;margin:0;padding:0}
.pl-committee li{padding:.55rem 0;border-top:1px solid #d7e5f1}
.pl-committee li:first-child{border-top:0}
.pl-committee .pl-when{background:#4d7ea8}
.pl-committee .pl-where{font-weight:700}
.pl-committee .pl-what{display:block;font-size:.95rem;margin:.1rem 0}
.pl-committee .pl-meta{margin:.1rem 0 0}
.pl-maparea{margin:0 0 1.6rem}
.pl-maparea h2{font-size:1.2rem;margin:0 0 .4rem;color:var(--green-dark,#2E3D26)}
#pl-map{height:380px;border-radius:10px;border:1px solid #dfe6d8}
@media (max-width:600px){ #pl-map{height:320px} }
.pl-chips{display:flex;flex-wrap:wrap;gap:.4rem;margin:0 0 .6rem}
.pl-chip{padding:.3rem .7rem;border:1px solid #b9c9ad;border-radius:999px;background:#fff;color:#2f4a22;font:inherit;font-size:.9rem;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:.35rem}
.pl-chip[aria-pressed="true"]{background:#3F5233;border-color:#3F5233;color:#fff}
.pl-dot{display:inline-block;width:11px;height:11px;border-radius:50%;border:2px solid #fff;box-shadow:0 0 0 1px rgba(0,0,0,.35)}
.pl-mapnote{margin:.4rem 0 0;font-size:.88rem;color:var(--muted,#666)}
.pl-pin{border-radius:50%;border:2px solid #fff;box-shadow:0 0 0 1px rgba(0,0,0,.4),0 1px 3px rgba(0,0,0,.3)}
.pl-pin.pl-pin-homes{box-shadow:0 0 0 3px #b5471b,0 1px 3px rgba(0,0,0,.3)}
.pl-key span{background:#fff;border:1px solid #e6e1d6;border-radius:8px;padding:.35rem .7rem;font-size:.92rem}
</style>
<main class="container">
  <div class="page-head">
    <h1>{{ heading or "Planning applications" }}</h1>
    <p class="page-intro">{{ pageIntro | safe }}</p>
    <p class="muted">Updated each week from Wychavon's lists. <a href="{{ council.planning.commentUrl }}" target="_blank" rel="noopener">Search all applications on Wychavon's site</a> &middot; <a href="/living-here/council/#planning">Parish councils and how to comment</a></p>
  </div>
  {#- Comments close soon (28 Nov 2026, Jon): undecided applications whose comment period ends in the
      next 10 days (lib/planning.js closingSoon), soonest first; left out when there are none. -#}
  {%- set closing = (planning.open if planning and planning.open else []) | planningClosing %}
  {%- if closing.length %}
  <section class="pl-closing" id="comments-close-soon">
    <h2>Comments close soon</h2>
    <p class="pl-sub">Want to have your say? These applications stop taking comments in the next 10 days.</p>
    <ul>
      {%- for e in closing %}
      {%- set d = e.consultationEnd | dateParts %}
      <li>
        <span class="pl-when" data-pagefind-ignore>By {{ d.dow }} {{ d.day }} {{ d.mon }} &middot; {{ e.daysLeft | planningDaysLeft }}</span>{% if e.homesLabel %}<span class="pl-badge-homes" data-pagefind-ignore>{{ e.homesLabel }}</span>{% endif %}
        <span class="pl-where">{{ e.location }}</span>
        <span class="pl-what">{{ e.proposal }}{% if not e.proposal.endsWith('.') %}.{% endif %}</span>
        <p class="pl-meta"><a href="{{ e.link }}" target="_blank" rel="noopener">See the plans and comment on Wychavon's site &rarr;</a> &middot; <a href="{{ e.location | planningMap }}" target="_blank" rel="noopener">Map &rarr;</a></p>
      </li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}
  {#- Going to planning committee (28 Nov 2026, Jon): undecided applications with a committee date in
      the next 21 days (lib/planning.js atCommittee), from each application's Wychavon page; left out when none. -#}
  {%- set cttee = (planning.open if planning and planning.open else []) | planningCommittee %}
  {%- if cttee.length %}
  <section class="pl-committee" id="planning-committee">
    <h2>Going to planning committee</h2>
    <p class="pl-sub">Wychavon's planning committee will decide these at its meeting on the date shown. Committee meetings are open to the public.</p>
    <ul>
      {%- for e in cttee %}
      {%- set d = e.committee | dateParts %}
      <li>
        <span class="pl-when" data-pagefind-ignore>Committee {{ d.dow }} {{ d.day }} {{ d.mon }}</span>{% if e.homesLabel %}<span class="pl-badge-homes" data-pagefind-ignore>{{ e.homesLabel }}</span>{% endif %}
        <span class="pl-where">{{ e.location }}</span>
        <span class="pl-what">{{ e.proposal }}{% if not e.proposal.endsWith('.') %}.{% endif %}</span>
        <p class="pl-meta"><a href="{{ e.link }}" target="_blank" rel="noopener">See the application on Wychavon's site &rarr;</a> &middot; <a href="{{ e.location | planningMap }}" target="_blank" rel="noopener">Map &rarr;</a></p>
      </li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}
  {#- Map (28 Nov 2026, Jon): a pin per application with a point (scripts/planning placeAll: grid
      references exact, others at their postcode's centre); filter buttons; each pin's popup links to
      its card below. Shown by the script only, so without JavaScript nothing appears. -#}
  {%- set pins = planning | planningMapPoints if planning else [] %}
  {%- if pins.length %}
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" integrity="sha512-Zcn6bjR/8RZbLEpLIeOwNtzREBAJnUKESxces60Mpoj+2okopSAcSUIUOseddDm0cxnGQzxIR7vJgsLZbdLE3w==" crossorigin="anonymous" referrerpolicy="no-referrer">
  <section class="pl-maparea" id="planning-map" hidden data-pagefind-ignore>
    <h2>On the map</h2>
    <div class="pl-chips" role="group" aria-label="Show on the map">
      <button type="button" class="pl-chip" data-show="all" aria-pressed="true">All</button>
      <button type="button" class="pl-chip" data-show="closing" aria-pressed="false"><span class="pl-dot" style="background:#c58a12"></span>Comments close soon</button>
      <button type="button" class="pl-chip" data-show="open" aria-pressed="false"><span class="pl-dot" style="background:#3F7A2E"></span>Open for comments</button>
      <button type="button" class="pl-chip" data-show="homes" aria-pressed="false"><span class="pl-dot" style="background:#b5471b"></span>New homes</button>
      <button type="button" class="pl-chip" data-show="waiting" aria-pressed="false"><span class="pl-dot" style="background:#4d7ea8"></span>Awaiting a decision</button>
      <button type="button" class="pl-chip" data-show="decided" aria-pressed="false"><span class="pl-dot" style="background:#8a8a8a"></span>Decided</button>
    </div>
    <div id="pl-map"></div>
    <p class="pl-mapnote">Most pins are at the centre of the application's postcode, so near the site rather than on it. A red ring means new homes. Tap a pin for the details.</p>
  </section>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js" integrity="sha512-BwHfrr4c9kmRkLw6iXFdzcdWV/PGkVgiIyIWLLlTSXzWQzxuSg4DiQUCpauz/EWjgk5TYQqX/kvn9pG1NpYfqg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
  <script>
  (function(){
    var PINS={{ pins | dump | safe }},area=document.getElementById('planning-map');
    if(!area||!window.L||!PINS.length)return;
    area.hidden=false;
    var COL={closing:'#c58a12',open:'#3F7A2E',waiting:'#4d7ea8',appeal:'#a0522d',decided:'#8a8a8a'};
    var LABEL={closing:'Comments close soon',open:'Open for comments',waiting:'Awaiting a decision',appeal:'At appeal',decided:'Decided'};
    function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return '&#'+c.charCodeAt(0)+';'})}
    var map=L.map('pl-map',{scrollWheelZoom:false,dragging:!L.Browser.mobile,zoomSnap:0.25});
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'}).addTo(map);
    var marks=PINS.map(function(p){
      var m=L.marker([p.lat,p.lng],{icon:L.divIcon({className:'pl-pin'+(p.homes?' pl-pin-homes':''),iconSize:[16,16],html:'<span style="display:block;width:100%;height:100%;border-radius:50%;background:'+(COL[p.kind]||COL.waiting)+'"></span>'}),title:p.location});
      m.bindPopup('<strong>'+esc(p.location)+'</strong><br>'+esc(p.proposal)+'<br><em>'+esc(LABEL[p.kind]||'')+(p.decision?': '+esc(p.decision):'')+'</em>'+(p.homes?' &middot; new homes':'')+(p.approx?'<br><small>Pin at the postcode centre</small>':'')+'<br><a href="#'+esc(p.anchor)+'">See it below</a>');
      m.pin=p;return m;
    });
    var chips=[].slice.call(area.querySelectorAll('.pl-chip'));
    function show(w){
      var b=[];marks.forEach(function(m){var p=m.pin;var on=w==='all'||(w==='homes'?p.homes>0:w==='open'?(p.kind==='open'||p.kind==='closing'):w==='waiting'?(p.kind==='waiting'||p.kind==='appeal'||p.kind==='open'||p.kind==='closing'):p.kind===w);
        if(on){m.addTo(map);b.push(m.getLatLng());}else map.removeLayer(m);});
      if(b.length)map.fitBounds(b,{padding:[24,24],maxZoom:14});
    }
    chips.forEach(function(c){c.addEventListener('click',function(){chips.forEach(function(x){x.setAttribute('aria-pressed',x===c?'true':'false')});show(c.dataset.show);});});
    show('all');map.invalidateSize();
  })();
  </script>
  {%- endif %}
  {%- set weeks = planning.weeks if planning and planning.weeks else [] %}
  {%- for w in weeks %}
  <section class="month pl-week">
    <h2 class="list-label" id="week-{{ w.from }}">{{ weekHead(w) }}</h2>
    {%- set empty = [] %}{% set notYet = [] %}
    {%- for p in parts %}
    {%- set list = w[p[0]] or [] %}
    {%- if not list.length %}{% if w.lists and w.lists[p[0]] %}{% set empty = (empty.push(p[3]), empty) %}{% else %}{% set notYet = (notYet.push(p[3]), notYet) %}{% endif %}{% endif %}
    {%- for e in list %}
    {%- set d = e.date | dateParts if e.date else null %}
    <div class="item-card{% if e | planningHomes %} pl-homes{% endif %}" id="pl-{{ e.ref | slugify }}">
      {%- if d %}<div class="date" data-pagefind-ignore><span class="dow">{{ d.dow }}</span><span class="day">{{ d.day }}</span><span class="mon">{{ d.mon }}</span></div>{% endif %}
      <div class="item-body">
        <span class="pl-label pl-{{ p[1] | lower | replace(' ', '-') }}" data-pagefind-ignore>{{ p[1] }}{% if e.decision %}: {{ e.decision }}{% endif %}</span>{% set hl = e | planningHomes %}{% if hl %}<span class="pl-badge-homes" data-pagefind-ignore>{{ hl }}</span>{% endif %}
        <h3 id="pl-{{ e.ref | slugify }}-t">{{ e.location }}</h3>
        <p>{{ e.proposal }}{% if not e.proposal.endsWith('.') %}.{% endif %}</p>
        <p class="pl-meta">{% if e.type %}{{ e.type }} &middot; {% endif %}<a href="{{ e.link }}" target="_blank" rel="noopener">{{ e.ref }} on Wychavon's site &rarr;</a> &middot; <a href="{{ e.location | planningMap }}" target="_blank" rel="noopener">Map &rarr;</a></p>
      </div>
    </div>
    {%- endfor %}
    {%- endfor %}
    {%- if empty.length %}<p class="pl-none">No {% if empty.length > 2 %}{{ empty.slice(0, -1) | join(", ") }} or {{ empty | last }}{% else %}{{ empty | join(" or ") }}{% endif %} this week.</p>{% endif %}
    {%- if notYet.length %}<p class="pl-none">{{ notYet | join(" and ") | capitalize }}: not yet published by Wychavon.</p>{% endif %}
  </section>
  {%- else %}
  <p class="muted">No weekly lists yet: check back after the next one.</p>
  {%- endfor %}
  {%- set open = planning.open if planning and planning.open else [] %}
  {%- set k = open | planningCounts %}
  {%- set shown = [] %}{% for w in weeks %}{% for e in w.applications or [] %}{% set shown = (shown.push(e.ref), shown) %}{% endfor %}{% endfor %}
  {%- set older = [] %}{% set recent = [] %}{% for e in open %}{% if e.decisionDate %}{% set recent = (recent.push(e), recent) %}{% elif e.ref not in shown %}{% set older = (older.push(e), older) %}{% endif %}{% endfor %}
  {%- if open.length %}
  <hr class="pl-divider">
  <section class="month pl-week" id="awaiting">
    <h2 class="pl-awaiting-head" id="awaiting-a-decision">Still awaiting a decision</h2>
    <p class="pl-none">Older applications Wychavon hasn't decided yet. Ones from the weeks above aren't repeated here.</p>
    <div class="pl-key" data-pagefind-ignore>
      <span><b>{{ k.total }}</b> application{{ "" if k.total == 1 else "s" }} awaiting a decision in all</span>
      {%- if k.withHomes %}<span><b>{{ k.withHomes }}</b> include{{ "s" if k.withHomes == 1 else "" }} new homes ({{ k.homes }} home{{ "" if k.homes == 1 else "s" }} at most)</span>{% endif %}
      {%- if k.comments %}<span><b>{{ k.comments }}</b> open for comments</span>{% endif %}
    </div>
    {%- for e in older %}
    {%- set d = e.valid | dateParts if e.valid else null %}
    <div class="item-card{% if e.homes %} pl-homes{% endif %}" id="open-{{ e.ref | slugify }}">
      {%- if d %}<div class="date" data-pagefind-ignore><span class="dow">{{ d.dow }}</span><span class="day">{{ d.day }}</span><span class="mon">{{ d.mon }}</span></div>{% endif %}
      <div class="item-body">
        {% if e.type %}<span class="pl-label" data-pagefind-ignore>{{ e.type }}</span>{% endif %}{% if e.homesLabel %}<span class="pl-badge-homes" data-pagefind-ignore>{{ e.homesLabel }}</span>{% endif %}
        <h3 id="open-{{ e.ref | slugify }}-t">{{ e.location }}</h3>
        <p>{{ e.proposal }}{% if not e.proposal.endsWith('.') %}.{% endif %}</p>
        <p class="pl-status">{% for x in e | planningStatus %}{% if not loop.first %} &middot; {% endif %}{% if x.strong %}<strong>{{ x.text }}</strong>{% else %}{{ x.text }}{% endif %}{% endfor %}</p>
        <p class="pl-meta"><a href="{{ e.link }}" target="_blank" rel="noopener">{{ e.ref }} on Wychavon's site &rarr;</a> &middot; <a href="{{ e.location | planningMap }}" target="_blank" rel="noopener">Map &rarr;</a></p>
      </div>
    </div>
    {%- endfor %}
    {%- if not older.length %}<p class="pl-none">None: every undecided application is in the weeks above.</p>{% endif %}
    <p class="pl-none">New homes first, then newest first.</p>
    {%- if recent.length %}
    <h3 class="pl-recent-head" id="recently-decided">Recently decided</h3>
    {%- for e in recent | sort(true, false, "decisionDate") %}
    {%- set d = e.decisionDate | dateParts %}
    <div class="item-card pl-decided{% if e.homes %} pl-homes{% endif %}" id="open-{{ e.ref | slugify }}">
      <div class="date" data-pagefind-ignore><span class="dow">{{ d.dow }}</span><span class="day">{{ d.day }}</span><span class="mon">{{ d.mon }}</span></div>
      <div class="item-body">
        <span class="pl-label pl-decision" data-pagefind-ignore>Decided: {{ e.decision }}</span>{% if e.homesLabel %}<span class="pl-badge-homes" data-pagefind-ignore>{{ e.homesLabel }}</span>{% endif %}
        <h3 id="open-{{ e.ref | slugify }}-t">{{ e.location }}</h3>
        <p>{{ e.proposal }}{% if not e.proposal.endsWith('.') %}.{% endif %}</p>
        <p class="pl-meta">{% if e.type %}{{ e.type }} &middot; {% endif %}<a href="{{ e.link }}" target="_blank" rel="noopener">{{ e.ref }} on Wychavon's site &rarr;</a> &middot; <a href="{{ e.location | planningMap }}" target="_blank" rel="noopener">Map &rarr;</a></p>
      </div>
    </div>
    {%- endfor %}
    <p class="pl-none">Decided applications stay here for 4 weeks after the decision.</p>
    {%- endif %}
  </section>
  {%- endif %}
  <p class="muted">From Wychavon District Council's weekly planning lists. Plans, documents and comments are on Wychavon's planning site: follow an application's reference.</p>
</main>
