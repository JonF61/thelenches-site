<section id="signup">
  <h2>Newsletter sign-up</h2>
  <div class="signup">
    <p class="mt0">Our newsletter is sent every <strong>Thursday morning</strong>. To join, simply email <a href="mailto:{{ site.email }}?subject=Add%20me%20to%20the%20mailing%20list">{{ site.email }}</a> and ask to be added to the mailing list.</p>
