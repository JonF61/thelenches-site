{#- Home's live bins line (both sites; moved from the Lenches Home 16 Nov 2026): needs bins and an element #home-bins. #}<script>
// Next bin collection per collection day, worked out on the reader's device so it moves on at
// 10am on collection day (the bins page's rule); the build-time lines stay if this fails.
(function () {
  var el = document.getElementById('home-bins');
  var data = {{ bins | binsSoon | dump | safe }};
  if (!el || !data.areas.length) return;
  var now = new Date();
  function toDate(s) { var p = s.split('-'); return new Date(+p[0], p[1] - 1, +p[2]); }
  function names(l) { return l.length < 2 ? l[0] : l.slice(0, -1).join(', ') + ' and ' + l[l.length - 1]; }
  var groups = [];
  data.areas.forEach(function (a) {
    var off = a.offset || 0, g = null;
    for (var i = 0; i < groups.length; i++) { if (groups[i].offset === off) g = groups[i]; }
    if (!g) { g = { offset: off, villages: [] }; groups.push(g); }
    g.villages.push(a.name);
  });
  var lines = [];
  groups.forEach(function (g) {
    for (var i = 0; i < data.collections.length; i++) {
      var c = data.collections[i];
      var d = toDate(c.date); d.setDate(d.getDate() + g.offset);
      var cutoff = new Date(d); cutoff.setHours(10, 0, 0, 0);
      if (cutoff > now) {
        var label = g.villages.length > 2 ? g.villages[0] + ' & others' : g.villages.join(' & ');
        var day = d.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' }).replace(',', '');
        lines.push(label + ': ' + day + ', ' + names(c.bins));
        break;
      }
    }
  });
  if (!lines.length) return;
  el.textContent = '';
  lines.forEach(function (l, i) { if (i) el.appendChild(document.createElement('br')); el.appendChild(document.createTextNode(l)); });
})();
</script>