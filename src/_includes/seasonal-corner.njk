{%- if not sk and seasonal.blossom %}{% set sk = 'blossom' %}{% endif -%}
{%- if not sk and seasonal.harvest %}{% set sk = 'harvest' %}{% endif -%}
{%- endif -%}
{%- if sk %}
<div class="container season-wrap" aria-hidden="true"><svg class="season-corner" viewBox="0 0 160 110" focusable="false">
