{#- Hub page of cards. The page's front matter supplies intro and cards (title, url, icon, text). -#}
{%- set icons = {
  users: '<circle cx="9" cy="8" r="3.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M16 14.2c2.8.3 5 2.6 5 5.8"/>',
  hall: '<path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-5h4v5"/>',
  church: '<path d="M12 2v5M10 4h4"/><path d="M6 21v-9l6-5 6 5v9"/><path d="M3 21h18"/><path d="M10 21v-4a2 2 0 0 1 4 0v4"/>',
  health: '<rect x="3" y="3" width="18" height="18" rx="4"/><path d="M12 8v8M8 12h8"/>',
  bus: '<rect x="4" y="3" width="16" height="15" rx="3"/><path d="M4 11h16"/><circle cx="8" cy="14.5" r="1"/><circle cx="16" cy="14.5" r="1"/><path d="M7 18v3M17 18v3"/>',
  council: '<path d="M12 3l8 5H4z"/><path d="M4 10h16M4 18h16M3 21h18"/><path d="M6 10v8M10 10v8M14 10v8M18 10v8"/>',
  school: '<path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/><path d="M22 9v6"/>',
  walk: '<path d="M12 3v18"/><path d="M5 6h11l3 2.5-3 2.5H5z"/><path d="M19 13H9l-3 2.5 3 2.5h10z"/>',
  bins: '<path d="M4 7h16M10 3h4"/><path d="M6 7l1 13h10l1-13"/><path d="M10 11v6M14 11v6"/>'
} -%}
<style>
.hub-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:.75rem;margin-top:1rem}
.hub-card{display:block;margin:0;text-decoration:none;color:inherit}
.hub-card h2{display:flex;align-items:center;gap:.5rem;margin:0 0 .25rem;font-size:1.08rem}
.hub-card svg{width:24px;height:24px;flex:none;color:#b5471b;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.hub-card p{margin:0;color:#666;font-size:.92rem}
.hub-card:hover h2,.hub-card:focus h2{text-decoration:underline}
</style>
<main class="container">
  <section>
    <h1>{{ title }}</h1>
    <p class="mt0">{{ intro }}</p>
    <div class="hub-grid">
      {%- for c in cards %}
      <a class="card hub-card" href="{{ c.url | url }}">
        <h2><svg viewBox="0 0 24 24" aria-hidden="true">{{ icons[c.icon] | safe }}</svg>{{ c.title }}</h2>
        <p>{{ c.text }}</p>
      </a>
      {%- endfor %}
    </div>
  </section>
</main>
