---
layout: base.njk
title: Contact & About
description: Contact the Lenches newsletter, submit content, and find village contacts.
---
<main class="container">

  <section>
    <h1>Contact &amp; About</h1>
    <p class="lead">This website supports the Lenches weekly newsletter and gathers village news, events and information in one place.</p>
  </section>

  <section>
    <h2>Get in touch</h2>
    <div class="card">
      <p class="mt0">For anything to do with the newsletter or website — corrections, questions or feedback — email
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>.</p>
    </div>
  </section>

  <section>
    <h2>Village contacts</h2>
    <table class="contacts">
      <caption class="sr-only">Village contacts</caption>
      <thead><tr><th scope="col">Organisation</th><th scope="col">Contact</th></tr></thead>
      <tbody>
        {#- Rows come from src/_data/contacts.json (council and school rows read council.json and schools.json). -#}
        {%- for id in contacts.table %}
        {%- set o = contacts.orgs[id] %}
        {%- set d = o %}
        {%- if o.council %}{% for p in council.parishes %}{% if p.key == o.council %}{% set d = p %}{% endif %}{% endfor %}{% endif %}
        {%- if o.school %}{% for sc in schools.local %}{% if sc.name == o.school %}{% set d = sc %}{% endif %}{% endfor %}{% endif %}
        {%- set email = site.email if o.siteEmail else d.email %}
        <tr><th scope="row">{{ o.name }}</th><td>
          {%- if o.see %}<a href="{{ o.see | url }}">Contact details on the Groups page</a>
          {%- else %}
            {%- if o.council %}Clerk: {% endif %}
            {%- if email %}<a href="mailto:{{ email }}">{{ email }}</a>{% endif %}
            {%- if d.phone %}{% if email %} &middot; {% endif %}{{ d.phone }}{% endif %}
            {%- if not email and not d.phone %}{% if d.contactUrl %}<a href="{{ d.contactUrl }}" target="_blank" rel="noopener">Contact form</a>{% elif o.url %}<a href="{{ o.url }}" target="_blank" rel="noopener">Website</a>{% endif %}{% endif %}
          {%- endif %}</td></tr>
        {%- endfor %}
      </tbody>
    </table>
  </section>

  <section>
    <h2>Useful local links</h2>
    <div class="grid">
      <div class="card">
        <h3>Councils &amp; services</h3>
        <p>
          <a href="https://www.southlenchesparishcouncil.org/" target="_blank" rel="noopener">South Lenches Parish Council</a><br>
          <a href="https://www.rouslenchparishcouncil.gov.uk/" target="_blank" rel="noopener">Rous Lench Parish Council</a><br>
          <a href="https://www.wychavon.gov.uk/" target="_blank" rel="noopener">Wychavon District Council</a>
        </p>
      </div>
      <div class="card">
        <h3>Church &amp; schools</h3>
        <p>
          <a href="https://www.archbenefice.org.uk/" target="_blank" rel="noopener">The Archbenefice (churches)</a><br>
          <a href="https://www.churchlench.worcs.sch.uk/" target="_blank" rel="noopener">Church Lench CofE First School</a><br>
          <a href="https://thelenchespreschool.org.uk/" target="_blank" rel="noopener">The Lenches Pre-school</a>
        </p>
      </div>
      <div class="card">
        <h3>Out and about</h3>
        <p>
          <a href="https://lenchestheatre.co.uk/" target="_blank" rel="noopener">Lenches Amphitheatre</a><br>
          <a href="https://www.valeandspa.co.uk/whats-on/" target="_blank" rel="noopener">Vale &amp; Spa — what's on</a>
        </p>
      </div>
    </div>
  </section>

  <section id="submit">
    <h2>Submit something for the newsletter</h2>
    <p>Got an event, notice or bit of news? Email it to <a href="mailto:{{ site.email }}">{{ site.email }}</a>. It goes in Thursday's newsletter and here on the site.</p>
    <div id="guidelines">
{% renderFile "./src/_includes/guidelines.md" %}
    </div>
  </section>

</main>
