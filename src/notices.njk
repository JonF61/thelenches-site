---
layout: base.njk
title: Notices
description: Notices and news from across the Lenches villages, from parish councils, local groups and the Evesham Journal.
---
{#- Items come from whatson.json (hand-edited) and pipeline.json (written by scripts/publish);
    the allNotices filter merges them, reads any old "news" lists as notices and drops expired ones.
    Road closures and roadworks (roadItems) are on /living-here/roads/ instead.
    Ids are ('notice-' + title) | slugify: the newsletter (lib/anchors.js) and /news/ redirects
    link to them, so keep them in step.
    "official": true (parish councils and other official bodies) shows an Official badge; those
    items are printed in their own words. "source" (Evesham Journal signposts) shows a source tag,
    and the link opens the article on the paper's site. -#}
<style>
.np-head{border-bottom:1px solid var(--line);padding-bottom:.6rem;margin-bottom:1.5rem}
.np-head h1{font-size:1.6rem;margin:0}
.np-date{margin:.15rem 0 0;font-size:.85rem;color:var(--muted)}
.np-section{margin-bottom:2rem}
.np-notice{padding:.6rem 0;border-top:1px solid var(--line);font-size:.95rem;scroll-margin-top:1.5rem}
.np-notice:last-of-type{border-bottom:1px solid var(--line)}
.np-notice p{margin:0 0 .45rem}
.np-notice p:last-child{margin-bottom:0}
.np-notice strong{color:var(--green-dark)}
.np-notice:target{background:#FDEBD8;box-shadow:0 0 0 3px var(--accent);border-radius:var(--radius);padding:.6rem .75rem}
.np-tag{display:inline-block;vertical-align:1px;margin-right:.35rem;padding:0 .45rem;border-radius:4px;font-size:.7rem;font-weight:600;line-height:1.6;white-space:nowrap}
.np-official{background:var(--green-dark);color:#fff}
.np-source{background:var(--green-light);color:var(--green-dark)}
.np-roads{margin:0 0 1.5rem}
</style>
<main class="container">
  <div class="np-head">
    <h1>Notices</h1>
    <p class="np-date">{{ updated | longDate }}</p>
  </div>

  {% set notices = pipeline | allNotices(whatson) | notRoadItems %}
  <section class="np-section">
    {% for n in notices %}
    <div class="np-notice" id="{{ ('notice-' + n.title) | slugify }}">
      {% for p in n.body | paras %}<p>{% if loop.first %}{% if n.official %}<span class="np-tag np-official">Official</span>{% endif %}{% if n.source %}<span class="np-tag np-source">{{ n.source | escape }}</span>{% endif %}<strong>{{ n.title | escape }}:</strong> {% endif %}{{ p | escape }}{% if loop.last %}{% if n.link %} {% if n.source %}<a href="{{ n.link.url | escape }}" target="_blank" rel="noopener external">{{ n.link.text | escape }} &#8599;<span class="sr-only"> (opens the {{ n.source | escape }} website)</span></a>{% else %}<a href="{{ n.link.url | escape }}" target="_blank" rel="noopener">{{ n.link.text | escape }} &rarr;</a>{% endif %}{% endif %}{% if n.image %} <a href="{{ n.image.url | url }}" data-viewer data-caption="{{ (n.image.alt or n.title) | escape }}">(image)</a>{% endif %}{% endif %}</p>{% endfor %}
    </div>
    {% else %}
    <p class="muted">No notices at the moment.</p>
    {% endfor %}
  </section>

  <p class="np-roads">Road closures and roadworks are on the <a href="{{ '/living-here/roads/' | url }}">Roads page</a>.</p>

  <div class="notice submit-note">Got something to include? Email <a href="mailto:{{ site.email }}">{{ site.email }}</a> by 6pm on Wednesday. See our <a href="{{ '/contact/' | url }}#submit">submission guidelines</a>.</div>
</main>
