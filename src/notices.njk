---
layout: base.njk
title: Notices
description: Notices and news from across the Lenches villages, from parish councils, local groups and the Evesham Journal.
---
{#- Items come from src/items/ (hand-edited, via lib/whatson.js) and pipeline.json (written by scripts/publish);
    the allNotices filter merges them, reads any old "news" lists as notices and drops expired ones.
    Road closures and roadworks (roadItems) are on /living-here/roads/ instead.
    Ids are ('notice-' + title) | slugify: the newsletter (lib/anchors.js) and /news/ redirects
    link to them, so keep them in step.
    Three sections: "official": true (parish councils and other official bodies, printed in their
    own words) in boxed panels, first paragraph shown and the rest behind "Read the full statement";
    "Around the villages" (everything else without a source), first paragraph shown and the rest
    behind "More"; "Worth knowing" ("source": Evesham Journal signposts), title and link only.
    The script at the end opens the <details> of a notice a URL hash points at. -#}
<style>
.np-head{border-bottom:1px solid var(--line);padding-bottom:.6rem;margin-bottom:1.5rem}
.np-head h1{font-size:1.6rem;margin:0}
.np-date{margin:.15rem 0 0;font-size:.85rem;color:var(--muted)}
.np-section{margin-bottom:2rem}
.np-section>h2{font-size:1.2rem;margin:0 0 .5rem;color:var(--green-dark)}
.np-notice{font-size:.95rem;scroll-margin-top:1.5rem}
.np-notice p{margin:0 0 .45rem}
.np-notice p:last-child{margin-bottom:0}
.np-notice:target{background:#FDEBD8;box-shadow:0 0 0 3px var(--accent);border-radius:var(--radius)}
.np-notice details{margin:.35rem 0 0}
.np-notice summary{cursor:pointer;color:var(--green-dark);font-weight:600;font-size:.9rem;padding:.55rem 0}
.np-notice summary::marker,.np-notice summary::-webkit-details-marker{color:var(--accent-text)}
.np-notice details[open] summary{padding-bottom:.35rem}
.np-label{display:block;margin:0 0 .25rem;font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.1em;color:var(--accent-text)}
.np-official{background:var(--card);border:2px solid var(--green-dark);border-radius:var(--radius);padding:1rem 1.15rem;margin-bottom:1rem}
.np-official:target{background:#FDEBD8;padding:1rem 1.15rem}
.np-official h3{font-size:1.1rem;margin:0 0 .5rem;color:var(--green-dark);line-height:1.35}
.np-official .np-link{margin-top:.5rem}
.np-row{padding:.65rem 0;border-top:1px solid var(--line)}
.np-row:last-child{border-bottom:1px solid var(--line)}
.np-row:target{padding:.65rem .75rem}
.np-row strong{color:var(--green-dark)}
.np-meta{display:flex;flex-wrap:wrap;gap:.35rem;align-items:center;margin:0 0 .15rem}
.np-meta .np-label{display:inline;margin:0}
.np-new{display:inline-block;padding:0 .45rem;border-radius:4px;font-size:.7rem;font-weight:600;line-height:1.6;background:var(--accent);color:#fff}
.np-worth{background:var(--green-light);border-radius:var(--radius);padding:.85rem 1.15rem;font-size:.92rem}
.np-worth h2{font-size:1.05rem;margin:0;color:var(--green-dark)}
.np-worth .np-caption{margin:0 0 .5rem;font-size:.8rem;color:var(--muted)}
.np-worth ul{list-style:none;margin:0;padding:0}
.np-worth li{padding:.4rem 0;border-top:1px solid var(--line)}
.np-worth li:target{padding:.4rem .6rem}
.np-worth a{white-space:nowrap}
.np-roads{margin:0 0 1.5rem}
.np-grid{display:grid;grid-template-columns:1fr;gap:1rem;align-items:start}
@media (min-width:760px){.np-grid{grid-template-columns:1fr 1fr}}
.np-card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:.9rem 1rem;overflow:hidden}
.np-card h3{font-size:1.02rem;line-height:1.35;margin:0 0 .35rem;color:var(--green-dark)}
.np-card .np-link{margin-top:.4rem;font-size:.9rem}
.np-card:target{background:#FDEBD8}
.np-thumb{float:right;width:7.5rem;margin:0 0 .5rem .75rem}
.np-thumb img{display:block;width:100%;aspect-ratio:3/2;object-fit:cover;border-radius:6px}
</style>
<main class="container">
  <div class="np-head">
    <h1>Notices</h1>
    <p class="np-date">{{ updated | longDate }}</p>
  </div>

  {% set notices = pipeline | allNotices(whatson) | notRoadItems %}
  {% set officials = notices | selectattr("official") %}
  {% set around = notices | rejectattr("official") | rejectattr("source") %}
  {% set worth = notices | rejectattr("official") | selectattr("source") %}

  {% if officials.length %}
  <section class="np-section">
    {#- Search (Pagefind) files text under the last heading with an id before it, so every section
        heading and every notice has one; otherwise a result links to the wrong notice. -#}
    <h2 class="sr-only" id="official-notices">Official notices</h2>
    {#- A short opening line ("Dear Parishioners") stays with the paragraph after it. -#}
    {% for n in officials %}{% set ps = n.body | paras %}{% set lead = 2 if (ps.length > 2 and ps[0].length < 40) else 1 %}
    <article class="np-notice np-official" id="{{ ('notice-' + n.title) | slugify }}">
      <span class="np-label">{% if 'parish council' in (n.title + ' ' + n.body) | lower %}From the parish council{% else %}Official notice{% endif %}</span>
      <h3 id="{{ ('notice-' + n.title) | slugify }}-t">{{ n.title | escape }}</h3>
      {% for p in ps %}{% if loop.index <= lead %}<p>{{ p | escape }}</p>{% endif %}{% endfor %}
      {% if ps.length > lead %}<details>
        <summary>Read the full statement</summary>
        {% for p in ps %}{% if loop.index > lead %}<p>{{ p | escape }}</p>{% endif %}{% endfor %}
      </details>{% endif %}
      {% if n.link or n.image %}<p class="np-link">{% if n.link %}<a href="{{ n.link.url | escape }}" target="_blank" rel="noopener">{{ n.link.text | escape }} &rarr;</a>{% endif %}{% if n.image %} <a href="{{ n.image.url | url }}" data-viewer data-caption="{{ ((n.image.alt or n.title) + (' — ' + n.image.credit if n.image.credit else '')) | escape }}">(image)</a>{% endif %}</p>{% endif %}
    </article>
    {% endfor %}
  </section>
  {% endif %}

  {% if around.length %}
  <section class="np-section">
    <h2 id="around-the-villages">Around the villages</h2>
    <div class="np-grid">
    {% for n in around %}{% set ps = n.body | leadSplit %}{% set isNew = ([n] | newThisWeek) > 0 %}
    <article class="np-notice np-card{% if n.image %} has-img{% endif %}" id="{{ ('notice-' + n.title) | slugify }}">
      {% if n.image %}<a class="np-thumb" href="{{ n.image.url | url }}" data-viewer data-caption="{{ ((n.image.alt or n.title) + (' — ' + n.image.credit if n.image.credit else '')) | escape }}"><img src="{{ n.image.url | url }}" alt="{{ (n.image.alt or '') | escape }}" loading="lazy"></a>{% endif %}
      {% if n.village or isNew %}<p class="np-meta" data-pagefind-ignore>{% if n.village %}<span class="np-label">{{ n.village | escape }}</span>{% endif %}{% if isNew %}<span class="np-new">New</span>{% endif %}</p>{% endif %}
      <h3 id="{{ ('notice-' + n.title) | slugify }}-t">{{ n.title | escape }}</h3>
      <p>{{ ps[0] | escape }}</p>
      {% if ps.length > 1 %}<details>
        <summary>More</summary>
        {% for p in ps %}{% if not loop.first %}<p>{{ p | escape }}</p>{% endif %}{% endfor %}
      </details>{% endif %}
      {% if n.link %}<p class="np-link"><a href="{{ n.link.url | escape }}" target="_blank" rel="noopener">{{ n.link.text | escape }} &rarr;</a></p>{% endif %}
    </article>
    {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if not officials.length and not around.length and not worth.length %}
  <p class="muted">No notices at the moment.</p>
  {% endif %}

  {% if worth.length %}
  <section class="np-section np-worth">
    <h2 id="worth-knowing">Worth knowing</h2>
    <p class="np-caption">From the Evesham Journal</p>
    <ul>
      {% for n in worth %}
      <li class="np-notice" id="{{ ('notice-' + n.title) | slugify }}">{{ n.title | escape }}{% if n.link %}<br><a href="{{ n.link.url | escape }}" target="_blank" rel="noopener external">{{ n.link.text | escape }} &#8599;<span class="sr-only"> (opens the {{ n.source | escape }} website)</span></a>{% endif %}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <p class="np-roads">Road closures and roadworks are on the <a href="{{ '/living-here/roads/' | url }}">Roads page</a>.</p>

  <div class="notice submit-note">Got something to include? Email <a href="mailto:{{ site.email }}">{{ site.email }}</a> by 6pm on Wednesday. See our <a href="{{ '/contact/' | url }}#submit">submission guidelines</a>.</div>
</main>
<script>
// Newsletter links point at a notice by id: open its folded text (and any <details> around it).
(function () {
  function openTarget() {
    var id = decodeURIComponent(location.hash.slice(1));
    var el = id && document.getElementById(id);
    if (!el) return;
    for (var p = el.parentElement; p; p = p.parentElement) if (p.tagName === 'DETAILS') p.open = true;
    var inner = el.querySelectorAll('details');
    for (var i = 0; i < inner.length; i++) inner[i].open = true;
  }
  openTarget();
  window.addEventListener('hashchange', openTarget);
})();
</script>
