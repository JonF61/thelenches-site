---
layout: base.njk
title: News
description: News and notices from across the Lenches villages.
---
{#- Items come from whatson.json (hand-edited) and pipeline.json (written by scripts/publish). -#}
{% set imgStyle = "display:block;max-width:100%;max-height:28rem;width:auto;height:auto;margin-top:.75rem;border-radius:6px" %}
{% set rowStyle = "padding:.9rem 0;border-top:1px solid var(--line)" %}
<main class="container">
  <section>
    <h1>News</h1>
    <p class="lead">News and notices from across the villages, gathered from the newsletter and other local sources.</p>
    <p><span class="datestamp">Page updated {{ updated | longDate }}</span></p>
    <div class="notice">Got something to include? Email <a href="mailto:{{ site.email }}">{{ site.email }}</a> by 6pm on Wednesday. See our <a href="{{ '/contact/' | url }}#submit">submission guidelines</a>.</div>
  </section>

  <section>
    <h2>News</h2>
    {% for n in pipeline.news | current | merge(whatson.news) %}
    <div style="{{ rowStyle }}">
      <h3 class="mt0">{{ n.title | escape }}</h3>
      <p class="mt0">{{ n.body | escape }}{% if n.link %} <a href="{{ n.link.url | escape }}" target="_blank" rel="noopener">{{ n.link.text | escape }} &rarr;</a>{% endif %}</p>
      {% if n.image %}<img src="{{ n.image.url | url }}" alt="{{ n.image.alt | escape }}" loading="lazy" style="{{ imgStyle }}">{% endif %}
    </div>
    {% else %}
    <p class="mut">No news at the moment.</p>
    {% endfor %}
  </section>

  <section>
    <h2>Notices</h2>
    {% for n in pipeline.notices | current | merge(whatson.notices) %}
    <div style="{{ rowStyle }}">
      <h3 class="mt0">{{ n.title | escape }}</h3>
      <p class="mt0">{{ n.body | escape }}{% if n.link %} <a href="{{ n.link.url | escape }}" target="_blank" rel="noopener">{{ n.link.text | escape }} &rarr;</a>{% endif %}</p>
      {% if n.image %}<img src="{{ n.image.url | url }}" alt="{{ n.image.alt | escape }}" loading="lazy" style="{{ imgStyle }}">{% endif %}
    </div>
    {% else %}
    <p class="mut">No notices at the moment.</p>
    {% endfor %}
  </section>
</main>
