---
layout: base.njk
title: News
description: News and notices from across the Lenches villages.
---
{#- Items come from whatson.json (hand-edited) and pipeline.json (written by scripts/publish). -#}
<main class="container">
  <div class="page-head">
    <h1>News</h1>
    <p class="page-intro">News and notices from across the villages &middot; updated {{ updated | longDate }}</p>
  </div>

  <section>
    <h2 class="list-label">Latest news</h2>
    {% for n in pipeline.news | current | merge(whatson.news) %}
    {#- id is linked from the home page's "more" links: keep the two in step -#}
    <div class="item-row" id="{{ ('news-' + n.title) | slugify }}">
      <div class="item-body">
        <h3>{{ n.title | escape }}</h3>
        <p>{{ n.body | escape }}{% if n.link %} <a href="{{ n.link.url | escape }}" target="_blank" rel="noopener">{{ n.link.text | escape }} &rarr;</a>{% endif %}</p>
      </div>
      {% if n.image %}<a class="thumb-link" href="{{ n.image.url | url }}" target="_blank" rel="noopener" aria-label="View full image"><img class="item-thumb" src="{{ n.image.url | url }}" alt="{{ n.image.alt | escape }}" loading="lazy"></a>{% endif %}
    </div>
    {% else %}
    <p class="muted">No news at the moment.</p>
    {% endfor %}
  </section>

  <section>
    <h2 class="list-label">Notices</h2>
    {% for n in pipeline.notices | current | merge(whatson.notices) %}
    <div class="item-row" id="{{ ('notice-' + n.title) | slugify }}">
      <div class="item-body">
        <h3>{{ n.title | escape }}</h3>
        <p>{{ n.body | escape }}{% if n.link %} <a href="{{ n.link.url | escape }}" target="_blank" rel="noopener">{{ n.link.text | escape }} &rarr;</a>{% endif %}</p>
      </div>
      {% if n.image %}<a class="thumb-link" href="{{ n.image.url | url }}" target="_blank" rel="noopener" aria-label="View full image"><img class="item-thumb" src="{{ n.image.url | url }}" alt="{{ n.image.alt | escape }}" loading="lazy"></a>{% endif %}
    </div>
    {% else %}
    <p class="muted">No notices at the moment.</p>
    {% endfor %}
  </section>

  <div class="notice submit-note">Got something to include? Email <a href="mailto:{{ site.email }}">{{ site.email }}</a> by 6pm on Wednesday. See our <a href="{{ '/contact/' | url }}#submit">submission guidelines</a>.</div>
</main>
